							d.hp.Color = Color3.fromRGB(255 * (1 - pct), 255 * pct, 40)
							d.hp.Visible = true
						else
							d.hp.Visible = false
						end
						if S.ESP_Distance then
							d.dist.Text = string.format("%dm", math.floor(distM))
							d.dist.Position = Vector2.new(pos.X, headPos.Y + h + 2)
							d.dist.Visible = true
						else
							d.dist.Visible = false
						end
					end
				end
			end
		end
	end
	for plr, d in pairs(espDraws) do
