-- Void spam: random SAFE ground positions (never void kill)
local voidSaved = nil
local lastVoid = 0
local function randomSafeCFrame(hrp)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local filter = {}
	if LP.Character then table.insert(filter, LP.Character) end
	params.FilterDescendantsInstances = filter
	params.IgnoreWater = true
	local base = hrp.Position
	for _ = 1, 8 do
		local x = base.X + math.random(-120, 120)
		local z = base.Z + math.random(-120, 120)
		local origin = Vector3.new(x, base.Y + 120, z)
		local hit = Workspace:Raycast(origin, Vector3.new(0, -400, 0), params)
		if hit and hit.Position then
			local y = hit.Position.Y + 4
			-- reject very low / void-ish
			if y > -50 then
				return CFrame.new(hit.Position.X, y, hit.Position.Z)
			end
		end
	end
	-- fallback near self slightly elevated
	return CFrame.new(base + Vector3.new(math.random(-20, 20), 6, math.random(-20, 20)))
end
