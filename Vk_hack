local _togPack = {}
local function addToggle(parent, key, label, default, onChange)
	S[key] = not not default
	local pack = _togPack[parent]
	if not pack or pack.n >= 2 then
		local line = Instance.new("Frame")
		line.Size = UDim2.new(1, 0, 0, 18)
		line.BackgroundTransparency = 1
		line.Parent = parent
		pack = { line = line, n = 0 }
		_togPack[parent] = pack
	end
	local i = pack.n
	pack.n = pack.n + 1
	local row = mkBtn({
		Size = UDim2.new(0.5, -2, 1, 0),
		Position = UDim2.new(i * 0.5, i == 0 and 0 or 2, 0, 0),
		BackgroundColor3 = C.row, Text = "",
	}, pack.line)
	local lab = Instance.new("TextLabel")
	lab.Size = UDim2.new(1, -28, 1, 0)
	lab.Position = UDim2.fromOffset(5, 0)
	lab.BackgroundTransparency = 1
	lab.Text = label
	lab.Font = Enum.Font.Code
	lab.TextSize = 10
	lab.TextColor3 = C.dim
	lab.TextXAlignment = Enum.TextXAlignment.Left
	lab.Parent = row
	local st = Instance.new("TextLabel")
	st.Size = UDim2.fromOffset(22, 18)
	st.Position = UDim2.new(1, -24, 0, 0)
	st.BackgroundTransparency = 1
	st.Font = Enum.Font.Code
	st.TextSize = 10
	st.TextXAlignment = Enum.TextXAlignment.Right
	st.Parent = row
	local function set(v)
		S[key] = not not v
		if S[key] then
			st.Text = "ON"
			st.TextColor3 = Color3.new(1, 1, 1)
			lab.TextColor3 = C.txt
			row.BackgroundColor3 = Color3.fromRGB(28, 22, 20)
		else
			st.Text = "--"
			st.TextColor3 = C.dim
			lab.TextColor3 = C.dim
			row.BackgroundColor3 = C.row
		end
		if onChange then pcall(onChange, S[key]) end
	end
	set(S[key])
	row.MouseButton1Click:Connect(function() set(not S[key]) end)
	UIRefs[key] = set
	return set
end

local function addSlider(parent, key, label, default, minv, maxv)
	_togPack[parent] = nil
	S[key] = default
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, 0, 0, 28)
	row.BackgroundTransparency = 1
	row.Parent = parent
	local lab = Instance.new("TextLabel")
	lab.Size = UDim2.new(1, 0, 0, 12)
	lab.BackgroundTransparency = 1
	lab.Text = label .. "  " .. tostring(default)
	lab.Font = Enum.Font.Code
	lab.TextSize = 10
	lab.TextColor3 = C.dim
	lab.TextXAlignment = Enum.TextXAlignment.Left
	lab.Parent = row
	local bar = Instance.new("Frame")
	bar.Size = UDim2.new(1, 0, 0, 8)
	bar.Position = UDim2.fromOffset(0, 14)
	bar.BackgroundColor3 = C.row
	bar.BorderSizePixel = 0
	bar.Parent = row
	stroke(bar)
	local fill = Instance.new("Frame")
	fill.Size = UDim2.new(math.clamp((default - minv) / (maxv - minv), 0, 1), 0, 1, 0)
	fill.BackgroundColor3 = C.accent
	fill.BorderSizePixel = 0
	fill.Parent = bar
	local dragging = false
	local function setFromX(x)
		local rel = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
		local v = math.floor(minv + (maxv - minv) * rel + 0.5)
		S[key] = v
		fill.Size = UDim2.new(rel, 0, 1, 0)
		lab.Text = label .. "  " .. tostring(v)
	end
	bar.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setFromX(i.Position.X)
		end
	end)
	UIS.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
	end)
	UIS.InputChanged:Connect(function(i)
		if not dragging then return end
		if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then
			setFromX(i.Position.X)
		end
	end)
	UIRefs[key] = function(v)
		S[key] = v
		local rel = math.clamp((v - minv) / (maxv - minv), 0, 1)
		fill.Size = UDim2.new(rel, 0, 1, 0)
		lab.Text = label .. "  " .. tostring(v)
	end
end

-- compact dropdown (half width of parent area via smaller list)
local function addDropdown(parent, label, options, current, onPick)
	local wrap = Instance.new("Frame")
	wrap.Size = UDim2.new(1, 0, 0, 0)
	wrap.AutomaticSize = Enum.AutomaticSize.Y
	wrap.BackgroundTransparency = 1
	wrap.Parent = parent
	local wLay = Instance.new("UIListLayout")
	wLay.Padding = UDim.new(0, 0)
	wLay.SortOrder = Enum.SortOrder.LayoutOrder
	wLay.Parent = wrap

	local isOpen = false
	local drop = mkBtn({
		Size = UDim2.new(0.55, 0, 0, 18), BackgroundColor3 = C.row,
		Text = label .. ": " .. tostring(current), TextColor3 = C.txt, TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, wrap)
	-- pad text
	drop.Text = " " .. label .. ": " .. tostring(current)

	local list = Instance.new("Frame")
	list.Size = UDim2.new(0.55, 0, 0, 0)
	list.AutomaticSize = Enum.AutomaticSize.Y
	list.BackgroundColor3 = C.bg
	list.BorderSizePixel = 0
	list.Visible = false
	list.ZIndex = 40
	list.Parent = wrap
	stroke(list)
	Instance.new("UIListLayout").Parent = list

	for _, name in ipairs(options) do
		local b = mkBtn({
			Size = UDim2.new(1, 0, 0, 16), BackgroundColor3 = C.row,
			Text = " " .. tostring(name), TextColor3 = C.txt, TextSize = 10,
			TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 41,
		}, list)
		b.MouseButton1Click:Connect(function()
			current = name
			drop.Text = " " .. label .. ": " .. tostring(name)
			list.Visible = false
			isOpen = false
			if onPick then onPick(name) end
		end)
	end
	drop.MouseButton1Click:Connect(function()
		isOpen = not isOpen
		list.Visible = isOpen
	end)
	return {
		set = function(v)
			current = v
			drop.Text = " " .. label .. ": " .. tostring(v)
		end,
		get = function() return current end,
	}
end

local _btnPack = {}
local function makeBtn(parent, text, fn, full)
	if full then
		_btnPack[parent] = nil
		local b = mkBtn({
			Size = UDim2.new(1, 0, 0, 18), BackgroundColor3 = C.row,
			Text = text, TextColor3 = C.txt, TextSize = 11,
		}, parent)
		b.MouseButton1Click:Connect(fn)
		return b
	end
	local pack = _btnPack[parent]
	if not pack or pack.n >= 2 then
		local line = Instance.new("Frame")
		line.Size = UDim2.new(1, 0, 0, 18)
		line.BackgroundTransparency = 1
		line.Parent = parent
		pack = { line = line, n = 0 }
		_btnPack[parent] = pack
	end
	local i = pack.n
	pack.n = pack.n + 1
	local b = mkBtn({
		Size = UDim2.new(0.5, -2, 1, 0),
		Position = UDim2.new(i * 0.5, i == 0 and 0 or 2, 0, 0),
		BackgroundColor3 = C.row, Text = text, TextColor3 = C.txt, TextSize = 11,
	}, pack.line)
	b.MouseButton1Click:Connect(fn)
	return b
end

