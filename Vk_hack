local function cleanName(n)
	n = tostring(n or "default"):gsub("[^%w%-%_]", "")
	if n == "" then n = "default" end
	return n
end
local function cfgPath(n) return CONFIG_DIR .. "/" .. cleanName(n) .. ".json" end
local function collectState()
	local out = {}
	for k, v in pairs(S) do
		local ty = type(v)
		if ty == "boolean" or ty == "number" or ty == "string" then out[k] = v end
	end
	return out
end
