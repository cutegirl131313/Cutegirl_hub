local function pick(name)
	curTab = name
	for n, pg in pairs(pages) do pg.Visible = (n == name) end
	for n, b in pairs(tabBtns) do
		b.TextColor3 = (n == name) and C.accent or C.dim
		b.BackgroundColor3 = (n == name) and Color3.fromRGB(28, 22, 20) or C.panel
	end
end

