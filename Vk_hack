	local lay = Instance.new("UIListLayout")
	lay.Padding = UDim.new(0, 4)
	lay.SortOrder = Enum.SortOrder.LayoutOrder
	lay.Parent = page
	pages[name] = page
	b.MouseButton1Click:Connect(function() pick(name) end)
	if not curTab then pick(name) end
	return page
end

