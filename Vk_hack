						local foot = cam:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
						local h = math.abs(headPos.Y - foot.Y)
						local w = h * 0.55
						local distM = myHRP and (hrp.Position - myHRP.Position).Magnitude or 0
						local scale = math.clamp(80 / math.max(distM, 10), 0.35, 1.2)
						h = h * scale
						w = w * scale
						if S.ESP_Box then
							d.box.Size = Vector2.new(w, h)
							d.box.Position = Vector2.new(pos.X - w / 2, headPos.Y)
