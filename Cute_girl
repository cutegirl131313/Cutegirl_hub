local _halmu = {
	rageEnabled = false,
	orbitEnabled = false,
	desyncDist = 3,
	orbitStuds = 8,
	currentTarget = nil,
	rageConn = nil,
	RealCFrame = nil,
	RealVelocity = nil,
	orbitAngle = 0,
	startRage = function() end,
}

function setOrbit(v)
	_halmu.orbitEnabled = v
end
function setOrbitStuds(v)
	_halmu.orbitStuds = v
end
function setDesyncDist(v)
