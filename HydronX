local function toEnum(name)
    if enum and enum.ToEnum then
        local ok, v = pcall(function() return enum:ToEnum(name) end)
        if ok and v ~= nil then return v end
    end
    return name
end

local function encCF(cf)
    if util and util.EncodeCFrame then
        local ok, v = pcall(function() return util:EncodeCFrame(cf) end)
        if ok and v ~= nil then return v end
    end
    local x, y, z = cf:ToOrientation()
    return {
        [utf8.char(0)] = cf.X, [utf8.char(1)] = cf.Y, [utf8.char(2)] = cf.Z,
        [utf8.char(3)] = x, [utf8.char(4)] = y, [utf8.char(5)] = z,
    }
end

local function itemId(item)
    if not item then return nil end
    local ok, id = pcall(function() return item:Get("ObjectID") end)
    if ok and id ~= nil then return id end
    local data = rawget(item, "Data")
    if type(data) == "table" and data.ObjectID ~= nil then return data.ObjectID end
    return rawget(item, "ObjectID")
end

local function isMelee(item)
    local info = item and rawget(item, "Info")
    if info and rawget(info, "Type") == "Melee" then return true end
    local n = string.lower(tostring(rawget(item, "Name") or ""))
    return n:find("knife", 1, true) or n:find("dagger", 1, true)
        or n:find("sword", 1, true) or n:find("katana", 1, true)
        or n:find("axe", 1, true) or n:find("scythe", 1, true)
        or n:find("spear", 1, true) or n:find("fist", 1, true)
        or n:find("maul", 1, true) or n:find("trowel", 1, true)
        or n:find("chainsaw", 1, true)
end

