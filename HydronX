local function fireShot(item, head, originPos, lookCF)
    if not UseItem or not item or not head then return end
    local oid = itemId(item)
    if not oid then return end
    local targetPos = head.Position
    local aimCF = lookCF or CFrame.lookAt(originPos, targetPos)
    local targetCF = head.CFrame
    local objSpace = head.CFrame:ToObjectSpace(CFrame.new(targetPos))
    local cameradata = {}
    cameradata[utf8.char(1)] = {
        [utf8.char(0)] = encCF(aimCF),
        [utf8.char(1)] = encCF(targetCF),
        [utf8.char(2)] = head,
        [utf8.char(3)] = encCF(objSpace),
    }
    if isMelee(item) then
        local AIM_ORIGIN = { ["\0"] = -1e30, ["\1"] = 0, ["\2"] = 0 }
        local AIM_END    = { ["\0"] = 0, ["\1"] = -9e7, ["\2"] = 0 }
        local AIM_EXTRA  = { ["\0"] = 0, ["\1"] = 1, ["\2"] = 0, ["\3"] = 0, ["\4"] = 0, ["\5"] = 0 }
        pcall(function()
            UseItem:FireServer(oid, toEnum("StartAiming"), {
                ["\1"] = { ["\0"] = AIM_ORIGIN, ["\1"] = AIM_END, ["\2"] = head, ["\3"] = AIM_EXTRA },
                ["\2"] = toEnum("HeavyAttackAnimation1"),
            }, nil)
        end)
        pcall(function()
            UseItem:FireServer(oid, toEnum("StartShooting"), {
                ["\1"] = { ["\0"] = AIM_ORIGIN, ["\1"] = AIM_END, ["\2"] = head, ["\3"] = AIM_EXTRA },
                ["\2"] = toEnum("AttackAnimation1"),
            }, nil)
        end)
    else
        pcall(function()
            UseItem:FireServer(oid, toEnum("StartShooting"), cameradata, nil)
        end)
    end
end

local function computeDest(tgt, now, dt)
    local root = CachedRoot
    if not root then return tgt.root.CFrame end
    if not State.OrbitEnabled then
        return tgt.root.CFrame * CFrame.new(0, 0.2, State.DesyncDistance)
    end
    State.OrbitAngle = State.OrbitAngle + State.OrbitSpeed * dt
    if State.OrbitAngle > math.pi * 2 then State.OrbitAngle = State.OrbitAngle - math.pi * 2 end
    local offset = Vector3.new(
        math.cos(State.OrbitAngle) * State.OrbitRadius,
        1.5,
        math.sin(State.OrbitAngle) * State.OrbitRadius
    )
    return CFrame.new(tgt.root.Position + offset, tgt.head.Position)
end

local lastLoopTick = os.clock()

task.spawn(function()
    while true do
        task.wait(FIRE_RATE)
        if not State.RageEnabled then continue end
        refreshCache()
        local now = os.clock()
        local dt = now - lastLoopTick
        lastLoopTick = now
        if dt > 0.5 or dt < 0 then dt = 0.016 end
        local tgt = getTarget()
        if not tgt then continue end
        local root = CachedRoot
        if not root then continue end
        local elapsed = tick() - State.PhaseStart
        if State.Phase == "rage" and elapsed >= State.RageInterval then
            State.Phase = "void"
            State.PhaseStart = tick()
        elseif State.Phase == "void" and elapsed >= State.VoidSpamInterval then
            State.Phase = "rage"
            State.PhaseStart = tick()
        end
        if State.Phase == "rage" then
            local dest = computeDest(tgt, now, dt)
            if State.DesyncEnabled then saveCF() end
            pcall(function()
                root.CFrame = dest
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
            end)
            if (tick() - State.LastFire) >= FIRE_RATE then
                State.LastFire = tick()
                local item = getItem()
                if item then
                    local lookCF = CFrame.lookAt(dest.Position, tgt.head.Position)
                    fireShot(item, tgt.head, dest.Position, lookCF)
                end
            end
        elseif State.Phase == "void" then
            if State.VoidSpamEnabled then
                if State.DesyncEnabled then saveCF() end
                pcall(function()
                    root.CFrame = CFrame.new(0, State.VoidSpamHeight, 0)
                    root.AssemblyLinearVelocity = Vector3.zero
                end)
            end
        end
    end
end)

