UnlockGroup:AddToggle("SkinUnlockerToggle", {
    Text = "Unlock All Skins",
    Default = false,
    Callback = function(v)
        if not v then
            Library:Notify("Skin unlocker off. Rejoin to reset.", 3)
            return
        end
        local ok = pcall(function()
            local modules = ReplicatedStorage:WaitForChild("Modules", 2)
            local cosLib = require(modules:WaitForChild("CosmeticLibrary", 2))
            local datCtrl = require(LP.PlayerScripts.Controllers:WaitForChild("PlayerDataController", 2))

            local allTypes = {
                Skin = true, Wrap = true, Charm = true, Dance = true, Emote = true,
                Finisher = true, FinisherEffect = true, FinisherSound = true, KillEffect = true,
            }
            local function isAllType(c) return c and allTypes[c.Type] == true end

            cosLib.OwnsCosmetic = function(_, _, nm) return isAllType(cosLib.Cosmetics[nm]) end
            cosLib.OwnsCosmeticNormally = cosLib.OwnsCosmetic
            cosLib.OwnsCosmeticUniversally = cosLib.OwnsCosmetic
            cosLib.OwnsCosmeticForWeapon = cosLib.OwnsCosmetic

            local origGet = datCtrl.Get
            datCtrl.Get = function(self, key)
                local val = origGet(self, key)
                if key == "CosmeticInventory" then
                    local proxy = {}
                    if val then
                        for k, vv in pairs(val) do
                            if isAllType(cosLib.Cosmetics[k]) then proxy[k] = vv end
                        end
                    end
                    return setmetatable(proxy, {
                        __index = function(_, k)
                            if isAllType(cosLib.Cosmetics[k]) then return true end
                            return nil
                        end,
                    })
                end
                return val
            end
        end)
        if ok then
            Library:Notify("Unlock applied (local only)", 3)
        else
            Library:Notify("Unlock failed — game structure changed", 3)
        end
    end,
})

local RankCharmGroup = Tabs.Visuals:AddRightGroupbox("Rank Charm (visual overlay)")

local SEASONS = {"Season 0", "Season 1", "Season 2", "Season 3"}
local RANKS = {
    "Unranked", "Bronze 1", "Bronze 2", "Bronze 3",
    "Silver 1", "Silver 2", "Silver 3",
    "Gold 1", "Gold 2", "Gold 3",
    "Platinum 1", "Platinum 2", "Platinum 3",
    "Diamond 1", "Diamond 2", "Diamond 3",
    "Onyx 1", "Onyx 2", "Onyx 3",
    "Nemesis", "Archnemesis"
}

local rankCharmState = {
    enabled = false,
    season = "Season 0",
    rank = "Nemesis",
    textureId = "",
    appliedObjects = {},
}

local function clearCharmOverlay()
    for _, obj in pairs(rankCharmState.appliedObjects) do
        pcall(function() obj:Destroy() end)
    end
    rankCharmState.appliedObjects = {}
end

local function findCharmAttachment(vm)
    if not vm then return nil end
    local candidates = {}
    for _, d in ipairs(vm:GetDescendants()) do
        if d:IsA("BasePart") or d:IsA("MeshPart") then
            local n = string.lower(d.Name)
            if n:find("charm", 1, true) then
                table.insert(candidates, d)
            end
        end
    end
    return candidates[1]
end

local function applyCharmOverlay()
    clearCharmOverlay()
    if not rankCharmState.enabled then return end
    if rankCharmState.textureId == "" then return end

    pcall(function()
        local fc = require(LP.PlayerScripts.Controllers.FighterController)
        local lf = fc and fc.LocalFighter
        if not lf then return end
        local item = lf.EquippedItem
        if not item then return end
        local vm = rawget(item, "ViewModel")
        if not vm then return end
        local model = rawget(vm, "Model") or rawget(vm, "Instance")
        if not model then
            for _, d in ipairs(Workspace:GetDescendants()) do
                if d:IsA("Model") and d:FindFirstChild("Humanoid") == nil then
                    local owner = d:GetAttribute("Owner") or d:GetAttribute("Player")
                    if owner == LP.UserId or owner == LP.Name then
                        model = d
                        break
                    end
                end
            end
        end
        if not model then return end
        local target = findCharmAttachment(model)
        if not target then return end
        local decal = Instance.new("Decal")
        decal.Name = "HydronCharmOverlay"
        decal.Texture = "rbxassetid://" .. tostring(rankCharmState.textureId):gsub("%D", "")
        decal.Face = Enum.NormalId.Front
        decal.Parent = target
        table.insert(rankCharmState.appliedObjects, decal)
        local decal2 = Instance.new("Decal")
        decal2.Name = "HydronCharmOverlayB"
        decal2.Texture = decal.Texture
        decal2.Face = Enum.NormalId.Back
        decal2.Parent = target
        table.insert(rankCharmState.appliedObjects, decal2)
    end)
end

