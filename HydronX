local function refreshCache(force)
    local now = tick()
    if not force and (now - CacheRefresh) < 0.5 then return end
    CacheRefresh = now
    if not util then pcall(function() util = require(ReplicatedStorage.Modules.Utility) end) end
    if not enum then pcall(function() enum = require(ReplicatedStorage.Modules.EnumLibrary) end) end
    if not FighterController then pcall(function() FighterController = require(LP.PlayerScripts.Controllers.FighterController) end) end
    if not UseItem or not UseItem.Parent then
        pcall(function() UseItem = ReplicatedStorage.Remotes.Replication.Fighter.UseItem end)
    end
    CachedChar = LP.Character
    CachedRoot = CachedChar and CachedChar:FindFirstChild("HumanoidRootPart")
end

