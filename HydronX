local function isEnemy(plr)
    if not plr or plr == LP then return false end
    local ch = plr.Character
    if not ch then return false end
    local hum = ch:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if not State.TeamCheck then return true end
    local lTeamId = LP:GetAttribute("TeamID")
    local tTeamId = plr:GetAttribute("TeamID")
    if lTeamId ~= nil and tTeamId ~= nil and lTeamId == tTeamId then return false end
    local lCharTeam = LP.Character and LP.Character:GetAttribute("TeamID")
    local tCharTeam = ch:GetAttribute("TeamID")
    if lCharTeam ~= nil and tCharTeam ~= nil and lCharTeam == tCharTeam then return false end
    if LP.Team and plr.Team and LP.Team == plr.Team then return false end
    return true
end

local function isImmune(plr)
    if not State.ImmuneCheck then return false end
    if not plr then return true end
    local ch = plr.Character
    if not ch then return true end
    if ch:FindFirstChildOfClass("ForceField") then return true end
    local hrp = ch:FindFirstChild("HumanoidRootPart")
    if hrp and hrp:FindFirstChild("Attachment") then return true end
    local inv = ch:GetAttribute("Immune") or ch:GetAttribute("Invincible") or ch:GetAttribute("IsImmune")
    if inv == true then return true end
    local hum = ch:FindFirstChildOfClass("Humanoid")
    if hum then
        local hInv = hum:GetAttribute("Immune") or hum:GetAttribute("Invincible")
        if hInv == true then return true end
        if hum.Health <= 0 then return true end
    end
    local be = ch:FindFirstChild("BodyEffects")
    if be then
        local god = be:FindFirstChild("God") or be:FindFirstChild("Invincible")
        if god and god.Value then return true end
    end
    return false
end

local function getTarget()
    local myRoot = CachedRoot
    if not myRoot then return nil end
    local cam = Camera
    if not cam then return nil end
    refreshPlayerCache()
    local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    local best, bestD = nil, 1e9
    for i = 1, #PlayerCache do
        local plr = PlayerCache[i]
        if isEnemy(plr) and not isImmune(plr) then
            local ch = plr.Character
            local root = ch and ch:FindFirstChild("HumanoidRootPart")
            local head = ch and (ch:FindFirstChild("HitboxHead") or ch:FindFirstChild("Head"))
            if root and head then
                local sp, on = cam:WorldToViewportPoint(root.Position)
                if on and sp.Z > 0 then
                    local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                    if d < bestD then
                        bestD = d
                        best = { plr = plr, root = root, head = head, dist = d }
                    end
                end
            end
        end
    end
    return best
end

local function saveCF()
    local root = CachedRoot
    if root and not State.SavedCF then
        State.SavedCF = root.CFrame
        State.SavedVel = root.AssemblyLinearVelocity
    end
end

local function restoreCF()
    if not State.SavedCF then return end
    local root = CachedRoot
    if root then
        pcall(function()
            root.CFrame = State.SavedCF
            root.AssemblyLinearVelocity = State.SavedVel or Vector3.zero
        end)
    end
    State.SavedCF = nil
    State.SavedVel = nil
end

