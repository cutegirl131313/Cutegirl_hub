local function dist2(player)
    local char = player.Character
    local myChar = LP.Character
    if char and myChar then
        local root = char:FindFirstChild("HumanoidRootPart")
        local myRoot = myChar:FindFirstChild("HumanoidRootPart")
        if root and myRoot then
            return (root.Position - myRoot.Position).Magnitude
        end
    end
    return math.huge
end

local function getEspPlayerWeapon(player)
    if not player then return "" end
    local ok, name = pcall(function()
        local s, r = pcall(function()
            return require(LP.PlayerScripts.Controllers.FighterController)
        end)
        local fc = s and r or nil
        if fc and type(fc.GetFighter) == "function" then
            local s2, fighter = pcall(fc.GetFighter, fc, player)
            if s2 and fighter then
                local item = fighter.EquippedItem
                if item then
                    if type(item.Get) == "function" then
                        return tostring(item:Get("Name") or item:Get("ItemName") or "")
                    end
                    return tostring(item.Name or item.ItemName or "")
                end
            end
        end
        return nil
    end)
    if ok and name and name ~= "" and name ~= "nil" then return name end
    local char = player.Character
    if char then
        for _, ch in ipairs(char:GetChildren()) do
            if ch:IsA("Tool") then return ch.Name end
        end
        local attr = char:GetAttribute("EquippedItem") or char:GetAttribute("Weapon") or char:GetAttribute("CurrentWeapon")
        if attr then return tostring(attr) end
        local held = char:FindFirstChild("Item") or char:FindFirstChild("Weapon")
        if held then return held.Name end
    end
    return ""
end

