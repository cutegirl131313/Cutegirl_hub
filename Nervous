local lastRage = 0
local rageTarget = nil
RunService.Heartbeat:Connect(function()
	if S.RageBot or S.Orbit or S.Desync then
		rageTarget = pickRageHead()
	end
	if S.Orbit and rageTarget then
		local hrp = getHRP()
		if hrp then
			orbitAngle = orbitAngle + 0.05
			local tp = rageTarget.Position
			local o = Vector3.new(math.cos(orbitAngle) * (S.OrbitStuds or 8), 2, math.sin(orbitAngle) * (S.OrbitStuds or 8))
			hrp.CFrame = CFrame.new(tp + o, tp)
			hrp.AssemblyLinearVelocity = Vector3.zero
		end
	end
	if S.VoidSpam then
		local hrp = getHRP()
		if hrp then
			if not voidSaved then voidSaved = hrp.CFrame end
			hrp.CFrame = CFrame.new(0, -500, 0)
			hrp.AssemblyLinearVelocity = Vector3.zero
		end
	elseif voidSaved then
		local hrp = getHRP()
		if hrp then hrp.CFrame = voidSaved end
		voidSaved = nil
	end
	local hrp = getHRP()
	if hrp and (S.RageBot or S.Desync) and rageTarget then
		RealCFrame = hrp.CFrame
		RealVelocity = hrp.AssemblyLinearVelocity
		local tp = rageTarget.Position
		hrp.CFrame = CFrame.new(tp + Vector3.new(0, S.DesyncDist or 3, 0), tp)
		hrp.AssemblyLinearVelocity = Vector3.zero
	end
	if not S.RageBot or tick() - lastRage < 0.045 then return end
	if rageTarget and fireAt(rageTarget, "target") then lastRage = tick() end
end)

