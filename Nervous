-- ESP
local espFolder = {}
local hasDrawing = pcall(function() return Drawing and Drawing.new end)
local function clearEsp(plr)
	local t = espFolder[plr]
	if not t then return end
	for _, o in pairs(t) do pcall(function() o:Remove() end) end
	espFolder[plr] = nil
end
local function ensureEsp(plr)
	if not hasDrawing then return nil end
	if espFolder[plr] then return espFolder[plr] end
	local t = {}
	t.box = Drawing.new("Square")
	t.box.Thickness = 1
	t.box.Filled = false
	t.box.Color = Color3.fromRGB(180, 120, 255)
	t.box.Visible = false
	t.name = Drawing.new("Text")
	t.name.Size = 14
	t.name.Center = true
	t.name.Outline = true
	t.name.Color = Color3.fromRGB(255, 255, 255)
	t.name.Visible = false
	t.hp = Drawing.new("Text")
	t.hp.Size = 12
	t.hp.Center = true
	t.hp.Outline = true
	t.hp.Color = Color3.fromRGB(120, 255, 120)
	t.hp.Visible = false
	espFolder[plr] = t
	return t
end

RunService.RenderStepped:Connect(function()
	if not S.ESP then
		for plr in pairs(espFolder) do clearEsp(plr) end
		return
	end
	local cam = Workspace.CurrentCamera
	if not cam then return end
	local seen = {}
	for _, plr in ipairs(Players:GetPlayers()) do
		if validEnemy(plr) then
			seen[plr] = true
			local char = plr.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local t = ensureEsp(plr)
			if t and hrp and hum then
				local sp, on = cam:WorldToViewportPoint(hrp.Position)
				if on and sp.Z > 0 then
					local size = 2000 / math.max(sp.Z, 1)
					if S.ESP_Box then
						t.box.Size = Vector2.new(size * 0.8, size * 1.4)
						t.box.Position = Vector2.new(sp.X - size * 0.4, sp.Y - size * 0.7)
						t.box.Visible = true
					else t.box.Visible = false end
					if S.ESP_Name then
						t.name.Text = plr.DisplayName or plr.Name
						t.name.Position = Vector2.new(sp.X, sp.Y - size * 0.75 - 14)
						t.name.Visible = true
					else t.name.Visible = false end
					if S.ESP_HealthBar then
						t.hp.Text = math.floor(hum.Health) .. " HP"
						t.hp.Position = Vector2.new(sp.X, sp.Y + size * 0.75)
						t.hp.Visible = true
					else t.hp.Visible = false end
				else
					t.box.Visible = false
					t.name.Visible = false
					t.hp.Visible = false
				end
			end
		end
	end
	for plr in pairs(espFolder) do
		if not seen[plr] then clearEsp(plr) end
	end
end)

