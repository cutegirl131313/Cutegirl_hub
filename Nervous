local function CG_NormalizeKey(k)
	return string.upper((tostring(k or ""):gsub("%s+", "")))
end

local function CG_CheckKey()
	local provided = nil
	pcall(function()
		provided = (getgenv and getgenv().script_key) or _G.script_key or script_key
	end)
	if not provided or provided == "" then
		return false
	end
	provided = CG_NormalizeKey(provided)

	-- 1) keys.json (GitHub) 에 있는 키
	local list = {}
	local okFetch, body = pcall(function()
		return game:HttpGet("https://raw.githubusercontent.com/cutegirl131313/Cutegirl_hub/main/keys.json")
	end)
	if okFetch and body and #body > 2 then
		for key in string.gmatch(body, "\"key\"%s*:%s*\"([^\"]+)\"") do
			list[#list + 1] = CG_NormalizeKey(key)
		end
	end

	-- 2) 백업 허용 키 (keys.json 없을 때)
	if #list == 0 then
		list = { "CG-DEMO-0001-TEST", "CG-PREM-ABCD-EFGH" }
	end

	for _, k in ipairs(list) do
		if k == provided then
			return true
		end
	end
	return false
end

