local function removeESP(character)
    if healthBars[character] then
        if healthBars[character].Billboard then
            healthBars[character].Billboard:Destroy()
        end
        healthBars[character] = nil
    end
    if nameTags[character] then
        nameTags[character]:Destroy()
        nameTags[character] = nil
    end
end

local function updateHealthBars()
    for character, data in pairs(healthBars) do
        if not character or not character.Parent or not data.Humanoid or data.Humanoid.Health <= 0 then
            removeESP(character)
        else
            local healthPercent = math.clamp(data.Humanoid.Health / data.Humanoid.MaxHealth, 0, 1)
            data.Bar.Size = UDim2.new(1, 0, healthPercent, 0)

            if healthPercent > 0.5 then
                data.Bar.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
            elseif healthPercent > 0.25 then
                data.Bar.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
            else
                data.Bar.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
            end
        end
    end
end

