local SpoofGroup = Tabs.Spoofer:AddLeftGroupbox("Spoof Options", "user")
local Controls = {}

local function UpdateConfig()
    if Controls.victimToggle and Controls.victimToggle.Value then
        local id = tonumber(Controls.victimInput.Value)
        Config.victim = (id and id > 0) and math.floor(id) or LocalPlayer.UserId
    else
        Config.victim = LocalPlayer.UserId
    end
    if Controls.helperToggle and Controls.helperToggle.Value then
        Config.helper = tostring(Controls.helperInput.Value or "")
    else
        Config.helper = ""
    end
    if Controls.levelToggle and Controls.levelToggle.Value then
        Config.level = math.floor(tonumber(Controls.levelInput.Value) or 0)
    else
        Config.level = 0
    end
    if Controls.streakToggle and Controls.streakToggle.Value then
        Config.streak = math.floor(tonumber(Controls.streakInput.Value) or 0)
    else
        Config.streak = 0
    end
    if Controls.eloToggle and Controls.eloToggle.Value then
        Config.elo = math.floor(tonumber(Controls.eloInput.Value) or 0)
    else
        Config.elo = 0
    end
    if Controls.keysToggle and Controls.keysToggle.Value then
        Config.keys = math.floor(tonumber(Controls.keysInput.Value) or 0)
    else
        Config.keys = 0
    end
    if Controls.premiumToggle then Config.premium = not not Controls.premiumToggle.Value end
    if Controls.verifiedToggle then Config.verified = not not Controls.verifiedToggle.Value end
    if Controls.platformToggle and Controls.platformToggle.Value then
        Config.platform = tostring(Controls.platformDropdown.Value or "DESKTOP")
    else
        Config.platform = ""
    end
end

local function OnToggleChange()
    UpdateConfig()
    ApplySpoofs()

-- Watermark
pcall(function()
	local CoreGui = game:GetService("CoreGui")
	if CoreGui:FindFirstChild("CuteGirlWM") then CoreGui.CuteGirlWM:Destroy() end
	local sg = Instance.new("ScreenGui")
	sg.Name = "CuteGirlWM"
	sg.ResetOnSpawn = false
	sg.IgnoreGuiInset = true
	sg.DisplayOrder = 100
	sg.Parent = CoreGui
	local box = Instance.new("Frame")
	box.Size = UDim2.fromOffset(210, 22)
	box.Position = UDim2.fromOffset(12, 50)
	box.BackgroundColor3 = Color3.fromRGB(12, 12, 16)
	box.BackgroundTransparency = 0.15
	box.BorderSizePixel = 0
	box.Parent = sg
	local st = Instance.new("UIStroke")
	st.Color = Color3.fromRGB(0, 0, 0)
	st.Thickness = 1
	st.Parent = box
	local bar = Instance.new("Frame")
	bar.Size = UDim2.new(0, 2, 1, 0)
	bar.BackgroundColor3 = Color3.fromRGB(100, 140, 255)
	bar.BorderSizePixel = 0
	bar.Parent = box
	local lab = Instance.new("TextLabel")
	lab.Size = UDim2.new(1, -10, 1, 0)
	lab.Position = UDim2.fromOffset(8, 0)
	lab.BackgroundTransparency = 1
	lab.Font = Enum.Font.Code
	lab.TextSize = 12
	lab.TextXAlignment = Enum.TextXAlignment.Left
	lab.TextColor3 = Color3.fromRGB(235, 235, 240)
	lab.Text = "CuteGirl | PREMIUM | 0 fps"
	lab.Parent = box
	do
		local frames, last = 0, tick()
		local avg = 60
		game:GetService("RunService").RenderStepped:Connect(function()
			frames = frames + 1
			local now = tick()
			if now - last >= 0.5 then
				avg = frames / (now - last)
				frames = 0
				last = now
				if lab and lab.Parent then
					local phys = 0
					pcall(function() phys = workspace:GetRealPhysicsFPS() end)
					local show = phys > 1 and phys or avg
					lab.Text = string.format("CuteGirl | PREMIUM | %.0f fps", show)
				end
			end
		end)
	end
end)

end

