local function hitFX(dmg)
	if S.HitSound then
		pcall(function()
			local s = Instance.new("Sound"); s.SoundId = "rbxassetid://6042053626"; s.Volume = 1.5
			s.Parent = workspace.CurrentCamera or workspace; s:Play(); task.delay(1, function() s:Destroy() end)
		end)
	end
	if S.HitFlash then
		pcall(function()
			local sg = Instance.new("ScreenGui"); sg.IgnoreGuiInset = true; sg.Parent = hud()
			local f = Instance.new("Frame"); f.Size = UDim2.fromScale(1,1); f.BackgroundColor3 = Color3.new(1,1,1)
			f.BackgroundTransparency = 0.75; f.BorderSizePixel = 0; f.Parent = sg
			task.delay(0.07, function() sg:Destroy() end)
		end)
	end
	if not S.HitFeedback then return end
	local sg = Instance.new("ScreenGui"); sg.IgnoreGuiInset = true; sg.Parent = hud()
	local f1 = Instance.new("Frame"); f1.Size = UDim2.fromOffset(14,2); f1.AnchorPoint = Vector2.new(0.5,0.5)
	f1.Position = UDim2.fromScale(0.5,0.5); f1.Rotation = 45; f1.BorderSizePixel = 0; f1.BackgroundColor3 = Color3.new(1,1,1); f1.Parent = sg
	local f2 = f1:Clone(); f2.Rotation = -45; f2.Parent = sg
	local lab = Instance.new("TextLabel"); lab.BackgroundTransparency = 1; lab.Size = UDim2.fromOffset(90,24)
	lab.AnchorPoint = Vector2.new(0.5,0); lab.Position = UDim2.new(0.5,0,0.5,12); lab.Font = Enum.Font.Code
	lab.TextSize = 16; lab.TextColor3 = Color3.new(1,1,1); lab.TextStrokeTransparency = 0.2
	lab.Text = tostring(math.floor(dmg or 0)); lab.Parent = sg
	task.delay(0.4, function() sg:Destroy() end)
end

