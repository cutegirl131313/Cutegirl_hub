local function CG_getSS()
	CG_refresh()
	if CG_SS then return CG_SS end
	local en = CG_Enum or rawget(getfenv(), "__enum")
	if en then
		local ok, ss = pcall(function() return en:ToEnum("StartShooting") end)
		if ok then CG_SS = ss; return ss end
	end
	return nil
end

local function CG_getRemote()
	CG_refresh()
	if CG_UseItem then return CG_UseItem end
	local ok, r = pcall(function()
		return game:GetService("ReplicatedStorage").Remotes.Replication.Fighter.UseItem
	end)
	if ok then CG_UseItem = r end
	return CG_UseItem
end

local function CG_fire(head, mode)
	if not head or not head.Parent then return false end
	local remote = CG_getRemote()
	local ss = CG_getSS()
	local oid = CG_getOid()
	if not remote or not ss or not oid then return false end
	local cam = workspace.CurrentCamera
	local root = CG_LP.Character and CG_LP.Character:FindFirstChild("HumanoidRootPart")
	local hp = head.Position
	local from
	if mode == "target" then
		from = hp + Vector3.new(0, 0.1, 0)
	elseif mode == "above" then
		from = hp + Vector3.new(0, 1.5, 0)
	else
		from = (cam and cam.CFrame.Position) or (root and root.Position) or hp
	end
	local data = CG_encode(from, hp, head)
	if not data then return false end
	local ok = pcall(function()
		remote:FireServer(oid, ss, data, nil)
	end)
	return ok
end

local function CG_volleys(head, n)
	if not head then return end
	for i = 1, (n or 6) do
		if i % 3 == 1 then CG_fire(head, "target")
		elseif i % 3 == 2 then CG_fire(head, "camera")
		else CG_fire(head, "above") end
	end
end

-- namecall silent rewrite
pcall(function()
	if CG_hooked or type(hookmetamethod) ~= "function" then return end
	CG_hooked = true
	CG_refresh()
	local useItem = CG_getRemote()
	if not useItem then return end
	local wrap = newcclosure or function(f) return f end
	local old
	old = hookmetamethod(game, "__namecall", wrap(function(self, ...)
		local method = getnamecallmethod()
		local args = { ... }
		if method == "FireServer" and self == useItem then
			local on = false
			pcall(function() on = CG.KiciaSilent or silentAimEnabled end)
			if on and type(args[3]) == "table" then
				local head = CG_pickHead()
				if head then
					local cam = workspace.CurrentCamera
					local from = cam and cam.CFrame.Position or head.Position
					local data = CG_encode(from, head.Position, head)
					if data then args[3] = data end
				end
			end
			return old(self, unpack(args))
		end
		return old(self, ...)
	end))
end)

