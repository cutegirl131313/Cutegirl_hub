-- ===================== TARGET =====================
local function sameTeam(plr)
	if not S.TeamCheck then return false end
	local a, b = LP:GetAttribute("TeamID"), plr:GetAttribute("TeamID")
	if a and b and a == b then return true end
	if LP.Team and plr.Team and LP.Team == plr.Team then return true end
	return false
end

local function headOf(plr)
	local c = plr.Character
	if not c then return nil end
	return c:FindFirstChild("HitboxHead") or c:FindFirstChild("HitboxHeadSmall") or c:FindFirstChild("Head")
end

local function pick()
	local cam = workspace.CurrentCamera
	if not cam then return nil end
	local best, score = nil, -1e9
	local fov = S.FOV or 450
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LP and not sameTeam(plr) and plr.Character then
			local hum = plr.Character:FindFirstChildOfClass("Humanoid")
			local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
			local head = headOf(plr)
			if hum and hrp and head and hum.Health > 0 then
				local sp = cam:WorldToViewportPoint(head.Position)
				if sp.Z > 0 then
					local center = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
					local sd = (Vector2.new(sp.X, sp.Y) - center).Magnitude
					if sd <= fov then
						local dist = (cam.CFrame.Position - head.Position).Magnitude
						local sc = (fov - sd) * 2 - dist * 0.05
						if sc > score then score, best = sc, head end
					end
				end
			end
		end
	end
	return best
end

-- ===================== COMBAT =====================
local function oid()
	refresh()
	local lf = Fighter and Fighter.LocalFighter
	if not lf then return nil end
	if not lf.EquippedItem then pcall(function() lf:EquipItem(1) end) end
	local item = lf.EquippedItem
	if not item then return nil end
	local id
	pcall(function() if item.Get then id = item:Get("ObjectID") end end)
	pcall(function() if not id and item.Data then id = item.Data.ObjectID end end)
	return id, item, lf
end

local function encode(from, to, head)
	if not head then return nil end
	if not Util then refresh() end
	if not Util or not Util.EncodeCFrame then return nil end
	local target = S.NoSpread and head.Position or to
	local ok, data = pcall(function()
		local e = Util:EncodeCFrame(CFrame.new(from, target))
		local hit = Util:EncodeCFrame(CFrame.new(0.43, 0.25, 0.42))
		return { [utf8.char(1)] = {
			[utf8.char(0)] = e, [utf8.char(1)] = e,
			[utf8.char(2)] = head, [utf8.char(3)] = hit,
		}}
	end)
	return ok and data or nil
end

local lastAtk = 0
local function fire(head, mode)
	if not head or not head.Parent then return false end
	refresh()
	if not UseItem or not SS then return false end
	local id = select(1, oid())
	if not id then return false end
	local cam = workspace.CurrentCamera
	local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
	local hp = head.Position
	local from
	if mode == "target" then from = hp + Vector3.new(0, 0.12, 0)
	elseif mode == "above" then from = hp + Vector3.new(0, 1.5, 0)
	elseif mode == "back" then
		local m = head:FindFirstAncestorOfClass("Model") or head.Parent
		local th = m and m:FindFirstChild("HumanoidRootPart")
		from = th and (th.Position - th.CFrame.LookVector * 2.6 + Vector3.new(0, 0.25, 0)) or (hp + Vector3.new(0, 0.2, 0))
	else from = (cam and cam.CFrame.Position) or (root and root.Position) or hp end
	local data = encode(from, hp, head)
	if not data then return false end
	lastAtk = tick()
	return pcall(function() UseItem:FireServer(id, SS, data, nil) end)
end

local function strip(head)
	pcall(function()
		local m = head:FindFirstAncestorOfClass("Model") or head.Parent
		if not m then return end
		m:SetAttribute("CanTakeDamage", true)
		m:SetAttribute("Invincible", false)
		m:SetAttribute("SpawnProtection", false)
		for _, d in ipairs(m:GetDescendants()) do
			if d:IsA("ForceField") then d:Destroy() end
		end
	end)
end

local function desync(pos, look)
	local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	local saved, vel = hrp.CFrame, hrp.AssemblyLinearVelocity
	hrp.CFrame = CFrame.lookAt(pos, look or pos)
	hrp.AssemblyLinearVelocity = Vector3.zero
	pcall(function()
		RunService:BindToRenderStep("CG_ds", Enum.RenderPriority.Camera.Value - 1, function()
			if hrp then hrp.CFrame = saved; hrp.AssemblyLinearVelocity = vel end
			pcall(function() RunService:UnbindFromRenderStep("CG_ds") end)
		end)
	end)
end

-- silent rewrite
pcall(function()
	if type(hookmetamethod) ~= "function" then return end
	refresh()
	local remote = UseItem or RS.Remotes.Replication.Fighter.UseItem
	local wrap = newcclosure or function(f) return f end
	local old
	old = hookmetamethod(game, "__namecall", wrap(function(self, ...)
		local method = getnamecallmethod()
		local args = {...}
		if method == "FireServer" and self == remote and S.Silent and type(args[3]) == "table" then
			local head = pick()
			if head then
				local cam = workspace.CurrentCamera
				local from = cam and cam.CFrame.Position or head.Position
				local data = encode(from, head.Position, head)
				if data then args[3] = data end
			end
			return old(self, unpack(args))
		end
		return old(self, ...)
	end))
end)

local tSilent, tRage, tTrig, tRapid = 0, 0, 0, 0
bind(RunService.Heartbeat:Connect(function()
	local shooting = UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
		or UIS:IsKeyDown(Enum.KeyCode.ButtonR2)

	if S.Silent and shooting and tick() - tSilent >= 0.04 then
		local h = pick()
		if h then tSilent = tick(); fire(h, "camera"); fire(h, "target"); fire(h, "camera") end
	end

	if S.RapidFire and shooting and tick() - tRapid >= 0.05 then
		tRapid = tick()
		local h = pick()
		if h then fire(h, "camera"); fire(h, "target") end
	end

	if S.Trigger and tick() - tTrig >= 0.05 then
		local h = pick()
		if h then tTrig = tick(); fire(h, "camera"); fire(h, "target") end
	end

	if (S.Rage or S.Knife) and tick() - tRage >= 0.04 then
		local h = pick()
		if h then
			tRage = tick()
			strip(h)
			local model = h:FindFirstAncestorOfClass("Model") or h.Parent
			local th = model and model:FindFirstChild("HumanoidRootPart")
			local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
			local multi = math.clamp(S.RageMulti or 12, 1, 24)
			if S.Knife and hrp and th then
				pcall(function() local lf = Fighter and Fighter.LocalFighter; if lf then lf:EquipItem(3) end end)
				desync(th.Position - th.CFrame.LookVector * 2.7 + Vector3.new(0, 0.25, 0), th.Position)
				for i = 1, multi do fire(h, (i % 2 == 0) and "back" or "target") end
			elseif S.Rage and hrp then
				desync(h.Position + Vector3.new(0, S.RageHeight or 1.6, 0), h.Position)
				for i = 1, multi do
					fire(h, ({ "above", "target", "camera" })[((i - 1) % 3) + 1])
				end
			end
		end
	end

	if S.Desync and not S.Rage and not S.Knife then
		local h = pick()
		local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
		if h and hrp then desync(h.Position + Vector3.new(0, S.DesyncDist or 3, 0), h.Position) end
	end

	if S.Orbit then
		local h = pick()
		local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
		local model = h and (h:FindFirstAncestorOfClass("Model") or h.Parent)
		local th = model and model:FindFirstChild("HumanoidRootPart")
		if h and hrp and th then
			S._oa = (S._oa or 0) + 0.09
			local r = S.OrbitDist or 6
			desync(th.Position + Vector3.new(math.cos(S._oa)*r, 2, math.sin(S._oa)*r), th.Position)
			fire(h, "target"); fire(h, "camera")
		end
	end

	if S.VoidSpam then
		local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
		if hrp then
			if not S._void then S._void = hrp.CFrame end
			local saved = S._void
			hrp.CFrame = CFrame.new(math.random(-25000,25000), 5500+math.random(0,2000), math.random(-25000,25000))
			hrp.AssemblyLinearVelocity = Vector3.zero
			pcall(function()
				RunService:BindToRenderStep("CG_void", Enum.RenderPriority.Camera.Value - 1, function()
					if hrp and saved then hrp.CFrame = saved end
					pcall(function() RunService:UnbindFromRenderStep("CG_void") end)
				end)
			end)
		end
	else S._void = nil end
end))

