		RealCFrame = hrp.CFrame
		RealVelocity = hrp.AssemblyLinearVelocity
		local tp = current.head.Position
		local dist = math.clamp(S.ZombieDesync or 3, 1, 12)
		hrp.CFrame = CFrame.new(tp + Vector3.new(0, dist, 0), tp)
		hrp.AssemblyLinearVelocity = Vector3.zero
	end)

	pcall(function()
		RunService:BindToRenderStep("CGZ_Restore", 150, function()
			local S = _G.HUB
			if not S or not S.ZombieRage then return end
