		if key == "Fullbright" and type(applyFullbright) == "function" then pcall(applyFullbright, S.Fullbright) end
	end)
end

local function addSlider(label, key, minv, maxv, def, round)
	if S[key] == nil then S[key] = def end
	round = round or 0
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, -4, 0, 40)
	row.BackgroundColor3 = Color3.fromRGB(14, 14, 16)
	row.BorderSizePixel = 1
	row.BorderColor3 = STROKE
	row.Parent = content
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = UDim2.new(1, -10, 0, 18)
	l.Position = UDim2.fromOffset(8, 2)
	l.Font = Enum.Font.Code
	l.TextSize = 12
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.TextColor3 = TEXT
	l.Parent = row
	local function fmt(v)
		if round <= 0 then return tostring(math.floor(v + 0.5)) end
		local m = 10 ^ round
		return tostring(math.floor(v * m + 0.5) / m)
	end
	local bar = Instance.new("Frame")
	bar.Size = UDim2.new(1, -16, 0, 8)
	bar.Position = UDim2.new(0, 8, 0, 24)
	bar.BackgroundColor3 = Color3.fromRGB(28, 28, 32)
	bar.BorderSizePixel = 0
	bar.Parent = row
	local fill = Instance.new("Frame")
	fill.BorderSizePixel = 0
	fill.BackgroundColor3 = ACCENT
	fill.Parent = bar
	local function paint()
		local v = tonumber(S[key]) or def
		v = math.clamp(v, minv, maxv)
		S[key] = v
		local a = (v - minv) / (maxv - minv)
		fill.Size = UDim2.new(a, 0, 1, 0)
		l.Text = label .. "  " .. fmt(v)
	end
	paint()
	local sliding = false
	local function setFromX(x)
		local rel = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
		local v = minv + (maxv - minv) * rel
		if round <= 0 then v = math.floor(v + 0.5) else
			local m = 10 ^ round
			v = math.floor(v * m + 0.5) / m
		end
		S[key] = v
		paint()
	end
	bar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			sliding = true
			setFromX(input.Position.X)
		end
	end)
	UIS.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			sliding = false
		end
	end)
	UIS.InputChanged:Connect(function(input)
		if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			setFromX(input.Position.X)
		end
	end)
end

