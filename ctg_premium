-- Kicia Premium style Hit Feedback (hitmarker + damage + sound)
function addHitLog(targetName, damage)
	if not getgenv().HitLogEnabled then return end
	if not damage or damage <= 0 then return end
	pcall(playHitSound)

	local dmg = math.floor(damage)
	local isHead = dmg >= 50 -- rough headshot bias for style

	local sg = Instance.new("ScreenGui")
	sg.Name = "KiciaHitFeedback"
	sg.IgnoreGuiInset = true
	sg.ResetOnSpawn = false
	sg.DisplayOrder = 100001
	pcall(function()
		if gethui then sg.Parent = gethui()
		else sg.Parent = game:GetService("CoreGui") end
	end)

	-- center hitmarker (X)
	local function arm(rot, len)
		local f = Instance.new("Frame")
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Position = UDim2.fromScale(0.5, 0.5)
		f.Size = UDim2.fromOffset(len, 2)
		f.BackgroundColor3 = isHead and Color3.fromRGB(255, 60, 60) or Color3.fromRGB(255, 255, 255)
		f.BorderSizePixel = 0
		f.Rotation = rot
		f.Parent = sg
		local s = Instance.new("UIStroke")
		s.Thickness = 1
		s.Color = Color3.new(0, 0, 0)
		s.Parent = f
		return f
	end
	local a1 = arm(45, 16)
	local a2 = arm(-45, 16)

	-- damage text under crosshair
	local lab = Instance.new("TextLabel")
	lab.BackgroundTransparency = 1
	lab.Size = UDim2.fromOffset(100, 28)
	lab.AnchorPoint = Vector2.new(0.5, 0)
	lab.Position = UDim2.new(0.5, 0, 0.5, 14)
	lab.Font = Enum.Font.Code
	lab.TextSize = isHead and 20 or 16
	lab.TextStrokeTransparency = 0.15
	lab.TextStrokeColor3 = Color3.new(0, 0, 0)
	lab.TextColor3 = isHead and Color3.fromRGB(255, 70, 70) or Color3.fromRGB(255, 255, 255)
	lab.Text = isHead and (tostring(dmg) .. " HS") or tostring(dmg)
	lab.Parent = sg

	-- name tag small
	local nameL = Instance.new("TextLabel")
	nameL.BackgroundTransparency = 1
	nameL.Size = UDim2.fromOffset(160, 16)
	nameL.AnchorPoint = Vector2.new(0.5, 0)
	nameL.Position = UDim2.new(0.5, 0, 0.5, 36)
	nameL.Font = Enum.Font.Code
	nameL.TextSize = 12
	nameL.TextStrokeTransparency = 0.3
	nameL.TextColor3 = Color3.fromRGB(200, 200, 210)
	nameL.Text = tostring(targetName or "")
	nameL.Parent = sg

	-- edge flash (hit chams feel)
	local flash = Instance.new("Frame")
	flash.BackgroundColor3 = isHead and Color3.fromRGB(255, 40, 40) or Color3.fromRGB(255, 255, 255)
	flash.BackgroundTransparency = 0.85
	flash.BorderSizePixel = 0
	flash.Size = UDim2.fromScale(1, 1)
	flash.Parent = sg

	task.spawn(function()
		local t0 = 0
		while t0 < 0.45 and sg and sg.Parent do
			t0 = t0 + 0.02
			local p = t0 / 0.45
			local scale = 1 + p * 0.8
			if a1 and a1.Parent then
				a1.Size = UDim2.fromOffset(16 * scale, 2)
				a1.BackgroundTransparency = p
			end
			if a2 and a2.Parent then
				a2.Size = UDim2.fromOffset(16 * scale, 2)
				a2.BackgroundTransparency = p
			end
			lab.Position = UDim2.new(0.5, 0, 0.5, 14 - p * 20)
			lab.TextTransparency = p * 0.9
			lab.TextStrokeTransparency = 0.15 + p * 0.7
			nameL.TextTransparency = p
			flash.BackgroundTransparency = 0.85 + p * 0.15
			task.wait(0.02)
		end
		pcall(function() sg:Destroy() end)
	end)
end

local ccAngle = 0
local animTimer = 0
RunService.RenderStepped:Connect(function(dt)
    if not getgenv().CustomCrosshairEnabled then return end
    
    if getgenv().CrosshairSpinEnabled then
        ccAngle = (ccAngle + ((getgenv().CrosshairSpinSpeed or 2) * dt * 50)) % 360
        CustomCrosshairContainer.Rotation = ccAngle
