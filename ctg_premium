					[utf8.char(1)] = e,
					[utf8.char(3)] = Utility:EncodeCFrame(CFrame.new(0.43, 0.25, 0.42)),
				},
			}
			if head then
				data[utf8.char(1)][utf8.char(2)] = head
			end
		end
		UseItem:FireServer(oid, se, data, nil)
		-- second shot for revolvers that eat one packet
		task.defer(function()
			pcall(function()
				if S.RapidFire and isSemiWeapon(item) then
					UseItem:FireServer(oid, se, data, nil)
				end
			end)
		end)
