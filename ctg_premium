-- round / respawn soft reset (stops kick after 1 game)
task.spawn(function()
	local Players = game:GetService("Players")
	local LP = Players.LocalPlayer
	local function softReset()
		pcall(function()
			local cam = workspace.CurrentCamera
			if cam and cam.CameraType == Enum.CameraType.Scriptable then
				cam.CameraType = Enum.CameraType.Custom
			end
		end)
		pcall(function()
			if S then
				S._tp = false
				S._tp2 = false
			end
		end)
		pcall(function()
			local char = LP.Character
			if not char then return end
			local hum = char:FindFirstChildOfClass("Humanoid")
			local hrp = char:FindFirstChild("HumanoidRootPart")
			if hum then
				hum.PlatformStand = false
			end
			if hrp then
				for _, p in ipairs(char:GetDescendants()) do
					if p:IsA("BodyVelocity") or p:IsA("BodyGyro") then
						if p.Name == "HubFly" or p.Name == "HubFlyGyro" then
							p:Destroy()
						end
					end
				end
			end
		end)
	end
	LP.CharacterAdded:Connect(function()
		task.wait(0.3)
		softReset()
	end)
	-- also when returning to menu / player gui loads
	pcall(function()
		LP.CharacterRemoving:Connect(function()
			softReset()
		end)
	end)
end)


