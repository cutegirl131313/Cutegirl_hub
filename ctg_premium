local realCF, realVel
local lastRage = 0
RunService.Heartbeat:Connect(function()
	if not S.RageBot then
		realCF = nil
		return
	end
	local head = pickHead()
	if not head then return end
	pcall(function()
		local c = head:FindFirstAncestorOfClass("Model") or head.Parent
		if not c then return end
		c:SetAttribute("CanTakeDamage", true)
		c:SetAttribute("Invulnerable", false)
		c:SetAttribute("SpawnProtection", false)
		c:SetAttribute("IsImmune", false)
		for _, d in ipairs(c:GetChildren()) do
			if d:IsA("ForceField") then d:Destroy() end
		end
	end)
	local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
	if hrp and S.Desync then
		if not realCF then
			realCF = hrp.CFrame
			realVel = hrp.AssemblyLinearVelocity
		end
		local hum = LP.Character:FindFirstChildOfClass("Humanoid")
		if hum and hum.MoveDirection.Magnitude > 0.05 then
			realCF = realCF + hum.MoveDirection * (hum.WalkSpeed or 16) * (1 / 60)
		end
		local dd = S.DesyncDist or 3
		hrp.CFrame = CFrame.new(head.Position + Vector3.new(0, dd, 0), head.Position)
		hrp.AssemblyLinearVelocity = Vector3.zero
	end
	if tick() - lastRage < 0.05 then return end
	lastRage = tick()
	local multi = math.clamp(S.RageMulti or 12, 2, 30)
	local hp = head.Position
	local cam = workspace.CurrentCamera
	local origins = {
		hp + Vector3.new(0, 0.1, 0),
		hp + Vector3.new(0, 0.25, 0),
		(cam and cam.CFrame.Position) or hp,
	}
	refreshMods()
	local oid = getOid()
	if not oid or not UseItem or not SSEnum then return end
	for i = 1, multi do
		local from = origins[((i - 1) % #origins) + 1]
		local data = encodeShot(from, hp, head)
		if data then
			pcall(function()
				UseItem:FireServer(oid, SSEnum, data, nil)
			end)
		end
	end
	fireAt(head, "target")
	fireAt(head, "camera")
end)

pcall(function()
