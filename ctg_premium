local function notify(text, dur)
	dur = dur or 2
	pcall(function()
		local sg = Instance.new("ScreenGui")
		sg.Name = "CG_Notify"
		sg.ResetOnSpawn = false
		sg.IgnoreGuiInset = true
		sg.Parent = CoreGui
		local f = Instance.new("Frame")
		f.Size = UDim2.fromOffset(260, 36)
