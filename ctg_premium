RunService:BindToRenderStep("hub_aimbot", Enum.RenderPriority.Camera.Value + 1, function()
	if not S.Aimbot then return end
	local cam = Workspace.CurrentCamera
	if not cam then return end
	local fov = S.AimFOV or 300
	local center = cam.ViewportSize * 0.5
	local best, bestD = nil, fov
	local from = cam.CFrame.Position
	for _, plr in ipairs(Players:GetPlayers()) do
		if validEnemy(plr) then
			local head = getHead(plr)
			if head then
				local sp, on = cam:WorldToViewportPoint(head.Position)
				if on and sp.Z > 0 then
					local d = (Vector2.new(sp.X, sp.Y) - Vector2.new(center.X, center.Y)).Magnitude
					if d <= bestD then
						local wallOk = (not S.WallCheck) or hasLOS(from, head.Position, plr.Character)
						if wallOk then
							bestD = d
							best = head
						end
					end
				end
			end
		end
	end
	if not best then return end
	if best.Parent then
		local hh = best.Parent:FindFirstChild("HitboxHead") or best.Parent:FindFirstChild("Head")
		if hh then best = hh end
	end
	cam.CFrame = CFrame.lookAt(cam.CFrame.Position, best.Position)
end)

local lastSilent = 0
RunService.Heartbeat:Connect(function()
	local opt = silentOpts()
	if not opt.on then return end
	local holding = false
	pcall(function()
		holding = UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
			or UIS:IsKeyDown(Enum.KeyCode.ButtonR2)
	end)
	if not holding then return end
	if tick() - lastSilent < ((S.FPSSaver and 0.08) or 0.04) then return end
	if opt.chance < 100 and math.random(1, 100) > opt.chance then return end
	if opt.notReload then
		local reloading = false
		pcall(function()
			local lf = getFighter and getFighter()
			local item = lf and lf.EquippedItem
			if item then
				reloading = item:Get("Reloading") or item:Get("IsReloading") or false
			end
		end)
		if reloading then return end
	end
	if opt.scopedOnly then
		local scoped = false
		pcall(function()
			local lf = getFighter and getFighter()
			local item = lf and lf.EquippedItem
			if item then
				scoped = item:Get("IsScoped") or item:Get("Scoped") or item:Get("ADS") or false
			end
			local cam = Workspace.CurrentCamera
			if cam and cam.FieldOfView < 50 then scoped = true end
		end)
		if not scoped then return end
	end

	local ignoreWall = not opt.wall
	local fov = opt.withinFov and opt.fov or 9999
	local head = getCrosshair(fov)
	if not head then head = getTarget(ignoreWall, fov) end
	if not head then head = getNearest(ignoreWall) end
	if head and (opt.forceHead or opt.headPct >= 100 or math.random(1, 100) <= opt.headPct) then
		head = forceHeadPart(head)
	end

	if not head then return end
	if opt.wall and not canSilentTarget(head) then return end

	refreshMods()
	if not (Utility and EnumLibrary and UseItem) then return end
	local lf = getFighter()
	if not lf or not lf.EquippedItem then return end
	local ok, oid = pcall(function() return lf.EquippedItem:Get("ObjectID") end)
	local okE, se = pcall(function() return EnumLibrary:ToEnum("StartShooting") end)
	if not (ok and oid and okE and se) then return end
	-- camera origin = remote head bend (noscope / range)
	local cam = Workspace.CurrentCamera
	local from = (cam and cam.CFrame.Position) or head.Position
	local char = head:FindFirstAncestorOfClass("Model")
	if S.WallCheck then
		if not hasLOS(from, head.Position, char) and not canSilentTarget(head) then
			return
		end
	end
	local data = encodeShot(from, head.Position, head)
	if data then
		pcall(function() UseItem:FireServer(oid, se, data, nil) end)
		-- second packet glued on head for consistency
		local data2 = encodeShot(head.Position + Vector3.new(0, 0.05, 0), head.Position, head)
		if data2 then
			pcall(function() UseItem:FireServer(oid, se, data2, nil) end)
		end
		lastSilent = tick()
	end
end)

