local hasDrawing = (typeof(Drawing) == "table" and Drawing.new) or (type(Drawing) == "table")
local espDrawings = {}

local function espClearPlr(plr)
	local t = espDrawings[plr]
	if not t then return end
	for _, o in pairs(t) do
		if type(o) == "table" then
			for _, sub in pairs(o) do
				pcall(function()
					if type(sub) == "userdata" or type(sub) == "table" then
						if sub.Remove then sub:Remove()
						elseif sub.Destroy then sub:Destroy() end
					end
				end)
			end
		else
			pcall(function()
				if o.Remove then o:Remove() elseif o.Destroy then o:Destroy() end
			end)
		end
	end
	espDrawings[plr] = nil
end

local function espMakeDrawing(plr)
	if not hasDrawing then return nil end
	local t = {}
	local function sq(thick, col)
		local s = Drawing.new("Square")
		s.Visible = false
		s.Filled = false
		s.Thickness = thick
		s.Color = col
		s.Transparency = 1
		return s
	end
	local function tx(size, col)
		local t2 = Drawing.new("Text")
		t2.Visible = false
		t2.Size = size
		t2.Color = col
		t2.Center = true
		t2.Outline = true
		t2.OutlineColor = Color3.new(0, 0, 0)
		t2.Font = 2
		return t2
	end
	local function ln(thick, col)
		local l = Drawing.new("Line")
		l.Visible = false
		l.Thickness = thick
		l.Color = col
		l.Transparency = 1
		return l
	end
	t.boxOut = sq(4, Color3.new(0, 0, 0))
	t.box = sq(2, Color3.fromRGB(255, 255, 255))
	t.name = tx(14, Color3.fromRGB(255, 255, 255))
	t.dist = tx(12, Color3.fromRGB(200, 200, 210))
	t.weapon = tx(12, Color3.fromRGB(220, 220, 100))
	t.hpOut = ln(7, Color3.new(0, 0, 0))
	t.hp = ln(4, Color3.fromRGB(0, 255, 100))
	t.skelLines = {}
	for i = 1, 6 do
		t.skelLines[i] = ln(1.5, Color3.fromRGB(255, 255, 255))
	end
	espDrawings[plr] = t
	return t
end

local function worldToPos(pos)
	local sp, on = Cam:WorldToViewportPoint(pos)
	return Vector2.new(sp.X, sp.Y), on, sp.Z
end

