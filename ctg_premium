RunService.RenderStepped:Connect(function()
	if not (S.HeadTP or S.BackTP) then return end
	local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	local best, bestD = nil, 1e9
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LP and p.Character then
			local tr = p.Character:FindFirstChild("HumanoidRootPart")
			local hum = p.Character:FindFirstChildOfClass("Humanoid")
			if tr and hum and hum.Health > 0 then
				local d = (hrp.Position - tr.Position).Magnitude
				if d < bestD then bestD, best = d, tr end
			end
		end
	end
	if not best then return end
	if S.HeadTP then
		hrp.CFrame = best.CFrame + Vector3.new(0, 15, 0)
	elseif S.BackTP then
		hrp.CFrame = best.CFrame * CFrame.new(0, 0, 5)
	end
end)

RunService.RenderStepped:Connect(function()
	if not S.ThirdPerson then return end
	local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
	local cam = workspace.CurrentCamera
	if not hrp or not cam then return end
