-- ===================== TARGET =====================
local function sameTeam(plr)
	if not S.TeamCheck then return false end
	local a, b = LP:GetAttribute("TeamID"), plr:GetAttribute("TeamID")
	if a and b and a == b then return true end
	if LP.Team and plr.Team and LP.Team == plr.Team then return true end
	return false
end

local function getHead(plr)
	local c = plr.Character
	if not c then return nil end
	return c:FindFirstChild("HitboxHead")
		or c:FindFirstChild("HitboxHeadSmall")
		or c:FindFirstChild("Head")
end

local function pickTarget()
	local cam = workspace.CurrentCamera
	if not cam then return nil end
	local best, bestScore = nil, -1e9
	local fov = tonumber(S.FOV) or 400
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LP and not sameTeam(plr) and plr.Character then
			local hum = plr.Character:FindFirstChildOfClass("Humanoid")
			local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
			local head = getHead(plr)
			if hum and hrp and head and hum.Health > 0 then
				local sp, on = cam:WorldToViewportPoint(head.Position)
				if on or sp.Z > 0 then
					local center = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
					local sd = (Vector2.new(sp.X, sp.Y) - center).Magnitude
					if sd <= fov then
						local dist = (cam.CFrame.Position - head.Position).Magnitude
						local score = (fov - sd) - dist * 0.05
						if score > bestScore then
							bestScore = score
							best = head
						end
					end
				end
			end
		end
	end
	return best
end

-- ===================== COMBAT =====================
local function getOid()
	refreshMods()
	local lf = Fighter and Fighter.LocalFighter
	if not lf then return nil end
	if not lf.EquippedItem then
		pcall(function() lf:EquipItem(1) end)
	end
	local item = lf.EquippedItem
	if not item then return nil end
	local oid
	pcall(function() oid = item:Get("ObjectID") end)
	pcall(function() if not oid and item.Data then oid = item.Data.ObjectID end end)
	return oid
end

local function encodeShot(from, to, head)
	if not Util or not head then return nil end
	-- NoSpread: aim exactly at head center (no random cone)
	local target = to
	if S.NoSpread then
		target = head.Position
	end
	local ok, data = pcall(function()
		local e = Util:EncodeCFrame(CFrame.new(from, target))
		local hit = Util:EncodeCFrame(CFrame.new(0.43, 0.25, 0.42))
		return {
			[utf8.char(1)] = {
				[utf8.char(0)] = e,
				[utf8.char(1)] = e,
				[utf8.char(2)] = head,
				[utf8.char(3)] = hit,
			}
		}
	end)
	return ok and data or nil
end

-- No Recoil: keep camera stable while shooting
local preCamCF = nil
bind(RunService.RenderStepped:Connect(function()
	if not S.NoRecoil then
		preCamCF = nil
		return
	end
	local cam = workspace.CurrentCamera
	if not cam then return end
	local shooting = UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
		or UIS:IsKeyDown(Enum.KeyCode.ButtonR2)
	if shooting then
		if not preCamCF then
			preCamCF = cam.CFrame
		else
			-- lock pitch drift from recoil
			local look = preCamCF.LookVector
			local pos = cam.CFrame.Position
			cam.CFrame = CFrame.lookAt(pos, pos + look)
			preCamCF = cam.CFrame
		end
	else
		preCamCF = cam.CFrame
	end
end))

-- Auto Reload (Kicia-style: force reload when empty / low)
local lastReload = 0
bind(RunService.Heartbeat:Connect(function()
	if not S.AutoReload then return end
	if tick() - lastReload < 0.35 then return end
	refreshMods()
	local lf = Fighter and Fighter.LocalFighter
	if not lf or not lf.EquippedItem then return end
	local item = lf.EquippedItem
	local need = false
	pcall(function()
		local ammo = item.Get and item:Get("Ammo")
		local mag = item.Get and item:Get("MagSize")
		if ammo ~= nil and ammo <= 0 then need = true end
		if ammo ~= nil and mag ~= nil and ammo <= 0 then need = true end
		if item.Data then
			local a = item.Data.Ammo or item.Data.CurrentAmmo
			if a ~= nil and a <= 0 then need = true end
		end
	end)
	-- also reload attribute
	pcall(function()
		local a = item:GetAttribute("Ammo") or item:GetAttribute("CurrentAmmo")
		if a ~= nil and a <= 0 then need = true end
	end)
	if need then
		lastReload = tick()
		pcall(function()
			if item.Reload then item:Reload() end
		end)
		pcall(function()
			if lf.Reload then lf:Reload() end
		end)
		pcall(function()
			if StartShoot and UseItem then
				-- try reload enum if exists
				local re = EnumLib and EnumLib:ToEnum("Reload")
				local oid = getOid()
				if re and oid then
					UseItem:FireServer(oid, re, nil, nil)
				end
			end
		end)
	end
end))



local function fireAt(head, mode)
	if not head or not head.Parent then return false end
	refreshMods()
	if not UseItem or not StartShoot then return false end
	local oid = getOid()
	if not oid then return false end
	local cam = workspace.CurrentCamera
	local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
	local hp = head.Position
	local from
	if mode == "target" then
		from = hp + Vector3.new(0, 0.12, 0)
	elseif mode == "above" then
		from = hp + Vector3.new(0, 1.5, 0)
	else
		from = (cam and cam.CFrame.Position) or (root and root.Position) or hp
	end
	local data = encodeShot(from, hp, head)
	if not data then return false end
	return pcall(function()
		UseItem:FireServer(oid, StartShoot, data, nil)
	end)
end

local function stripProtect(head)
	pcall(function()
		local m = head:FindFirstAncestorOfClass("Model") or head.Parent
		if not m then return end
		m:SetAttribute("CanTakeDamage", true)
		m:SetAttribute("Invincible", false)
		m:SetAttribute("SpawnProtection", false)
		for _, d in ipairs(m:GetDescendants()) do
			if d:IsA("ForceField") then d:Destroy() end
		end
	end)
end

-- silent namecall rewrite
pcall(function()
	if type(hookmetamethod) ~= "function" then return end
	refreshMods()
	local remote = UseItem or RS.Remotes.Replication.Fighter.UseItem
	local wrap = newcclosure or function(f) return f end
	local old
	old = hookmetamethod(game, "__namecall", wrap(function(self, ...)
		local method = getnamecallmethod()
		local args = {...}
		if method == "FireServer" and self == remote and S.Silent and type(args[3]) == "table" then
			local head = pickTarget()
			if head then
				local cam = workspace.CurrentCamera
				local from = cam and cam.CFrame.Position or head.Position
				local data = encodeShot(from, head.Position, head)
				if data then args[3] = data end
			end
			return old(self, unpack(args))
		end
		return old(self, ...)
	end))
end)

local lastSilent, lastRage = 0, 0

bind(RunService.Heartbeat:Connect(function()
	-- Silent assist
	if S.Silent and tick() - lastSilent >= 0.045 then
		local shooting = UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
			or UIS:IsKeyDown(Enum.KeyCode.ButtonR2)
		if shooting then
			local head = pickTarget()
			if head then
				lastSilent = tick()
				fireAt(head, "camera")
				fireAt(head, "target")
			end
		end
	end

	-- Rage / Knife
	if (S.Rage or S.Knife) and tick() - lastRage >= 0.045 then
		local head = pickTarget()
		if head then
			lastRage = tick()
			stripProtect(head)
			local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
			local model = head:FindFirstAncestorOfClass("Model") or head.Parent
			local th = model and model:FindFirstChild("HumanoidRootPart")

			if S.Knife and hrp and th then
				pcall(function()
					local lf = Fighter and Fighter.LocalFighter
					if lf then lf:EquipItem(3) end
				end)
				local back = th.Position - th.CFrame.LookVector * 2.7 + Vector3.new(0, 0.25, 0)
				local saved, vel = hrp.CFrame, hrp.AssemblyLinearVelocity
				hrp.CFrame = CFrame.lookAt(back, th.Position)
				hrp.AssemblyLinearVelocity = Vector3.zero
				pcall(function()
					RunService:BindToRenderStep("CG_restore", Enum.RenderPriority.Camera.Value - 1, function()
						if hrp then hrp.CFrame = saved; hrp.AssemblyLinearVelocity = vel end
						pcall(function() RunService:UnbindFromRenderStep("CG_restore") end)
					end)
				end)
				fireAt(head, "target")
				fireAt(head, "camera")
				fireAt(head, "target")
			elseif S.Rage and hrp then
				local above = head.Position + Vector3.new(0, S.RageHeight or 1.5, 0)
				local saved, vel = hrp.CFrame, hrp.AssemblyLinearVelocity
				hrp.CFrame = CFrame.lookAt(above, head.Position)
				hrp.AssemblyLinearVelocity = Vector3.zero
				pcall(function()
					RunService:BindToRenderStep("CG_restore", Enum.RenderPriority.Camera.Value - 1, function()
						if hrp then hrp.CFrame = saved; hrp.AssemblyLinearVelocity = vel end
						pcall(function() RunService:UnbindFromRenderStep("CG_restore") end)
					end)
				end)
				fireAt(head, "above")
				fireAt(head, "target")
				fireAt(head, "camera")
				fireAt(head, "target")
			end
		end
	end
end))

