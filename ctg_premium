				[utf8.char(3)] = lX, [utf8.char(4)] = lY, [utf8.char(5)] = lZ,
			}
			local relCF = targetPart.CFrame:ToObjectSpace(CFrame.new(targetPos))
			local rX, rY, rZ = relCF:ToOrientation()
			return {
				[utf8.char(1)] = {
					[utf8.char(0)] = originStruct, [utf8.char(1)] = originStruct,
					[utf8.char(2)] = targetPart,
					[utf8.char(3)] = {
						[utf8.char(0)] = relCF.X, [utf8.char(1)] = relCF.Y, [utf8.char(2)] = relCF.Z,
						[utf8.char(3)] = rX, [utf8.char(4)] = rY, [utf8.char(5)] = rZ,
					},
				},
			}
		end

		_halmu.startRage = function(on)
			if _halmu.rageConn then _halmu.rageConn:Disconnect() _halmu.rageConn = nil end
			if not on then return end
			local cachedId = nil
			local lastFire = 0
			_halmu.rageConn = RunService.Heartbeat:Connect(function()
				if not _halmu.rageEnabled then return end
				if not _halmu.currentTarget or not _halmu.currentTarget.Parent then return end
				local targetChar = _halmu.currentTarget:FindFirstAncestorOfClass("Model") or _halmu.currentTarget.Parent
				local targetPlr = Players:GetPlayerFromCharacter(targetChar)
				if not targetPlr or targetPlr == LP then return end
				if _isSameTeam(targetPlr) then return end
				local hum = targetChar:FindFirstChildOfClass("Humanoid")
				if hum and hum.Health <= 0 then return end
				-- immunity check (rage only) — silent does NOT use this
				if _isImmune(targetPlr, targetChar) then return end
				-- beat enemy rage: zero delay + multi origin shots
				if tick() - lastFire < 0.0 then return end
				lastFire = tick()
				local objId = getObjId()
				if objId then cachedId = objId else objId = cachedId end
				if not objId or not _ssEnum then return end
				local head = _halmu.currentTarget
				-- re-resolve head every shot (anti desync swap)
				if targetChar then
					head = targetChar:FindFirstChild("HitboxHead")
						or targetChar:FindFirstChild("HitboxHeadSmall")
						or targetChar:FindFirstChild("Head")
						or head
					_halmu.currentTarget = head
				end
				if not head then return end
				local multi = math.clamp(tonumber(S.RageMulti) or 6, 1, 10)
				local hp = head.Position
				local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
				local camPos = workspace.CurrentCamera and workspace.CurrentCamera.CFrame.Position
				-- origins: on head, above head, from camera, from root (harder for enemy desync to dodge)
				local origins = {
					hp + Vector3.new(0, 0.05, 0),
					hp + Vector3.new(0, 0.35, 0),
					hp + Vector3.new(0.1, 0.1, 0),
					hp + Vector3.new(-0.1, 0.1, 0),
					camPos or hp,
					myRoot and myRoot.Position or hp,
				}
				for i = 1, multi do
					local origin = origins[((i - 1) % #origins) + 1]
					pcall(function()
						_useItemRemote:FireServer(objId, _ssEnum, buildShot(origin, head), nil)
					end)
				end
			end)
		end

		-- Desync: server sees offset pos, local view stays real
		-- Only while RageBot ON (and optional S.Desync). Fixed save/restore so it doesn't jitter.
		pcall(function() RunService:UnbindFromRenderStep("HalmuRestoreDesync") end)
		_halmu.RealCFrame = nil
		_halmu.RealVelocity = nil
		RunService.Heartbeat:Connect(function()
			pcall(function()
				local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
				if not hrp then
					_halmu.RealCFrame, _halmu.RealVelocity = nil, nil
					return
				end
				local want = _halmu.rageEnabled and _halmu.currentTarget and (_halmu.rageEnabled)
				-- also allow standalone desync flag if present
				if S.Desync and not _halmu.rageEnabled then
					want = true
				end
				if not want or not _halmu.currentTarget then
					_halmu.RealCFrame, _halmu.RealVelocity = nil, nil
					return
				end
				-- capture real pose once per desync session from visual frame
				if not _halmu.RealCFrame then
					_halmu.RealCFrame = hrp.CFrame
					_halmu.RealVelocity = hrp.AssemblyLinearVelocity
				else
					-- keep real CF updated from last restored visual (set in RenderStep)
					if _halmu._visualCF then
						_halmu.RealCFrame = _halmu._visualCF
						_halmu.RealVelocity = _halmu._visualVel or Vector3.zero
					end
				end
				local tp = _halmu.currentTarget.Position
				local dist = math.clamp(_halmu.desyncDist or 3, 1, 15)
				-- offset above target (stable, not random)
				hrp.CFrame = CFrame.new(tp + Vector3.new(0, dist, 0), tp)
				hrp.AssemblyLinearVelocity = Vector3.zero
				hrp.AssemblyAngularVelocity = Vector3.zero
			end)
		end)
		RunService:BindToRenderStep("HalmuRestoreDesync", Enum.RenderPriority.Camera.Value - 1, function()
			pcall(function()
				local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
				if not hrp or not _halmu.RealCFrame then return end
				-- show real position locally
				hrp.CFrame = _halmu.RealCFrame
				if _halmu.RealVelocity then
					hrp.AssemblyLinearVelocity = _halmu.RealVelocity
				end
				_halmu._visualCF = hrp.CFrame
				_halmu._visualVel = hrp.AssemblyLinearVelocity
			end)
		end)

		-- Target finder
		task.spawn(function()
			while true do
				task.wait(0.0)
				if _halmu.rageEnabled or _halmu.orbitEnabled then
					local ref = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
					local refPos = ref and ref.Position or Vector3.zero
					local closest, best = nil, math.huge
					for _, plr in pairs(Players:GetPlayers()) do
						if plr ~= LP and plr.Character and not _isSameTeam(plr) then
							local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
							local hum = plr.Character:FindFirstChild("Humanoid")
							if hrp and hum and hum.Health > 0 and not _isImmune(plr, plr.Character) then
								local d = (Vector3.new(refPos.X,0,refPos.Z) - Vector3.new(hrp.Position.X,0,hrp.Position.Z)).Magnitude
								if d < best then best = d closest = plr end
							end
						end
					end
					_halmu.currentTarget = closest and closest.Character and _getRageHead(closest.Character) or nil
				else
					_halmu.currentTarget = nil
				end
			end
		end)

		-- Orbit
		RunService:BindToRenderStep("HalmuOrbit", 100, function(dt)
			if not _halmu.orbitEnabled then return end
			local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
			if not hrp or not _halmu.currentTarget then return end
			_halmu.orbitAngle = (_halmu.orbitAngle or 0) + (dt or 0.016) * 3.5
			local tp = _halmu.currentTarget.Position
			local offset = Vector3.new(math.cos(_halmu.orbitAngle) * _halmu.orbitStuds, 2, math.sin(_halmu.orbitAngle) * _halmu.orbitStuds)
			hrp.CFrame = CFrame.new(tp + offset, tp)
			hrp.AssemblyLinearVelocity = Vector3.zero
		end)
	end)
end)

