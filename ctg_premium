local lastRapid = 0
RunService.Heartbeat:Connect(function()
	if not S.RapidFire then return end
	local lf = getFighter and getFighter() or nil
	if not lf or not lf.EquippedItem then return end
	if not isSemiWeapon(lf.EquippedItem) then return end

	local holding = false
	pcall(function()
		holding = UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
			or UIS:IsKeyDown(Enum.KeyCode.ButtonR2)
	end)
	if not holding then return end

	pcall(function()
		local item = lf.EquippedItem
		if item.Info and forceZeroInfo then forceZeroInfo(item.Info) end
		for _, k in ipairs({
			"ShootCooldown", "AttackCooldown", "LastShoot", "LastAttack", "NextShot", "Cooldown",
			"TimeSinceLastShot", "NextFireTime", "LastFireTime", "FireDelay",
		}) do
			if type(item[k]) == "number" then item[k] = 0 end
		end
		pcall(function()
			if item.Set then
				item:Set("ShootCooldown", 0)
				item:Set("Cooldown", 0)
				item:Set("CanShoot", true)
				item:Set("Ready", true)
			end
		end)
	end)

	-- faster spam for pistols/revolvers
	if tick() - lastRapid < 0.03 then return end
	lastRapid = tick()

	pcall(function()
		refreshMods()
		if not (Utility and EnumLibrary and UseItem) then return end
		local item = lf.EquippedItem
		local oid = item:Get("ObjectID")
		local se = EnumLibrary:ToEnum("StartShooting")
		if not oid or se == nil then return end
		local root = getRootPart and getRootPart() or nil
		local from = root and root.Position or Cam.CFrame.Position
		local to = from + Cam.CFrame.LookVector * 200
		local head = nil
		pcall(function()
			if getCrosshair then head = getCrosshair(S.AimFOV or 300) end
			if not head and getNearest then head = getNearest(false) end
		end)
