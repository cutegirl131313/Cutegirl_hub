-- Prevent overlay GUIs from blocking menu Play button
local function makeClickThrough(gui)
	pcall(function()
		if not gui then return end
		if gui:IsA("ScreenGui") then
			gui.DisplayOrder = math.min(gui.DisplayOrder or 0, 20)
		end
		if gui:IsA("GuiObject") then
			gui.Active = false
			gui.Selectable = false
		end
		for _, d in ipairs(gui:GetDescendants()) do
			if d:IsA("GuiObject") then
				-- keep only real buttons interactive inside Linoria later
				if not (d:IsA("TextButton") or d:IsA("ImageButton") or d:IsA("TextBox")) then
					d.Active = false
					d.Selectable = false
				end
			end
		end
	end)
end
