local lastReload = 0
bind(RunService.Heartbeat:Connect(function()
	if not S.AutoReload or tick() - lastReload < 0.4 then return end
	local oid, item, lf = getOid()
	if not item then return end
	local need = false
	pcall(function()
		local ammo = item.Get and item:Get("Ammo")
		if ammo ~= nil and ammo <= 0 then need = true end
		if item.Data and item.Data.Ammo ~= nil and item.Data.Ammo <= 0 then need = true end
	end)
	if need then
		lastReload = tick()
		pcall(function() if item.Reload then item:Reload() end end)
		pcall(function() if lf and lf.Reload then lf:Reload() end end)
		pcall(function() if ReloadEnum and oid and UseItem then UseItem:FireServer(oid, ReloadEnum, nil, nil) end end)
	end
end))

