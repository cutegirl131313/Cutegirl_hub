local FighterCtrl, EnumLib, UseItem, SSEnum, Utility

local function refreshMods()
	pcall(function()
		if not FighterCtrl then
			FighterCtrl = require(LP.PlayerScripts.Controllers.FighterController)
		end
	end)
	pcall(function()
		if not EnumLib then EnumLib = require(RS.Modules.EnumLibrary) end
	end)
	pcall(function()
		if not Utility then Utility = require(RS.Modules.Utility) end
	end)
	pcall(function()
		if not UseItem then UseItem = RS.Remotes.Replication.Fighter.UseItem end
	end)
	pcall(function()
		if not SSEnum and EnumLib then SSEnum = EnumLib:ToEnum("StartShooting") end
	end)
end

local function sameTeam(plr)
	if not S.TeamCheck then return false end
	local a, b = LP:GetAttribute("TeamID"), plr:GetAttribute("TeamID")
	if a and b and a == b then return true end
	if LP.Team and plr.Team and LP.Team == plr.Team then return true end
	return false
end

local function getOid()
	refreshMods()
	local lf = FighterCtrl and (FighterCtrl.LocalFighter or (FighterCtrl.GetFighter and FighterCtrl:GetFighter(LP)))
	local item = lf and lf.EquippedItem
	if not item then return nil end
	local ok, id = pcall(function() return item:Get("ObjectID") end)
	if ok and id then return id end
	ok, id = pcall(function() return item.Data and item.Data.ObjectID end)
	return ok and id or nil
end

local function getLocalFighter()
	refreshMods()
	return FighterCtrl and (FighterCtrl.LocalFighter or (FighterCtrl.GetFighter and FighterCtrl:GetFighter(LP)))
end

local function pickHead(maxDist)
	maxDist = maxDist or 5000
	local best, bestD = nil, maxDist
	local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
	local cam = workspace.CurrentCamera
	local ref = (root and root.Position) or (cam and cam.CFrame.Position)
	if not ref then return nil end
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LP and plr.Character and not sameTeam(plr) then
			local char = plr.Character
			local hum = char:FindFirstChildOfClass("Humanoid")
			local hrp = char:FindFirstChild("HumanoidRootPart")
			if hum and hrp and hum.Health > 0 then
				local d = (ref - hrp.Position).Magnitude
				if d < bestD then
					bestD = d
					best = char:FindFirstChild("HitboxHead")
						or char:FindFirstChild("HitboxHeadSmall")
						or char:FindFirstChild("Head")
						or hrp
				end
			end
		end
	end
	return best
end

local function visibleCheck(head)
	if not S.WallCheck then return true end
	local cam = workspace.CurrentCamera
	if not cam or not head then return true end
	local model = head:FindFirstAncestorOfClass("Model") or head.Parent
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { LP.Character }
	local origin = cam.CFrame.Position
	local dir = head.Position - origin
	local hit = workspace:Raycast(origin, dir, params)
	if not hit then return true end
	if model and hit.Instance:IsDescendantOf(model) then return true end
	return false
end

local function encodeShot(from, to, head)
	if typeof(from) ~= "Vector3" or typeof(to) ~= "Vector3" or not head then return nil end
	refreshMods()
	if Utility and type(Utility.EncodeCFrame) == "function" then
		local ok, data = pcall(function()
			local e = Utility:EncodeCFrame(CFrame.new(from, to))
			local hit = Utility:EncodeCFrame(CFrame.new(0.43, 0.25, 0.42))
			return {
				[utf8.char(1)] = {
					[utf8.char(0)] = e,
					[utf8.char(1)] = e,
					[utf8.char(2)] = head,
					[utf8.char(3)] = hit,
				},
			}
		end)
		if ok and data then return data end
	end
	local lookCF = CFrame.lookAt(from, to)
	local lX, lY, lZ = lookCF:ToOrientation()
	local originStruct = {
		[utf8.char(0)] = from.X, [utf8.char(1)] = from.Y, [utf8.char(2)] = from.Z,
		[utf8.char(3)] = lX, [utf8.char(4)] = lY, [utf8.char(5)] = lZ,
	}
	local relCF = head.CFrame:ToObjectSpace(CFrame.new(to))
	local rX, rY, rZ = relCF:ToOrientation()
	return {
		[utf8.char(1)] = {
			[utf8.char(0)] = originStruct,
			[utf8.char(1)] = originStruct,
			[utf8.char(2)] = head,
			[utf8.char(3)] = {
				[utf8.char(0)] = relCF.X, [utf8.char(1)] = relCF.Y, [utf8.char(2)] = relCF.Z,
				[utf8.char(3)] = rX, [utf8.char(4)] = rY, [utf8.char(5)] = rZ,
			},
		},
	}
end

local function fireAt(head, mode)
	if not head or not head.Parent then return end
	refreshMods()
	if not UseItem or not SSEnum then return end
	local oid = getOid()
	if not oid then return end
	local cam = workspace.CurrentCamera
	local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
	local targetPos = head.Position
	local from
	if mode == "target" then
		from = targetPos + Vector3.new(0, 0.12, 0)
	else
		from = (cam and cam.CFrame.Position) or (root and root.Position) or targetPos
	end
	local data = encodeShot(from, targetPos, head)
	if not data then return end
	pcall(function() UseItem:FireServer(oid, SSEnum, data, nil) end)
end

local function stripProtect(head)
	pcall(function()
		local c = head:FindFirstAncestorOfClass("Model") or head.Parent
		if not c then return end
		c:SetAttribute("CanTakeDamage", true)
		c:SetAttribute("Invulnerable", false)
		c:SetAttribute("SpawnProtection", false)
		c:SetAttribute("SpawnProtect", false)
		c:SetAttribute("IsImmune", false)
		c:SetAttribute("Protected", false)
		for _, d in ipairs(c:GetDescendants()) do
			if d:IsA("ForceField") then pcall(function() d:Destroy() end) end
		end
	end)
end

local function parentGui(sg)
	pcall(function() if gethui then sg.Parent = gethui() end end)
	if not sg.Parent then pcall(function() sg.Parent = CoreGui end) end
	if not sg.Parent then
		pcall(function()
			sg.Parent = LP:FindFirstChild("PlayerGui") or LP:WaitForChild("PlayerGui", 3)
		end)
	end
end

