local function stopEmote()
	pcall(function()
		if getgenv().CurrentEmoteTrack then
			getgenv().CurrentEmoteTrack:Stop(0.15)
			getgenv().CurrentEmoteTrack:Destroy()
			getgenv().CurrentEmoteTrack = nil
		end
	end)
end

local function playEmote(name)
	stopEmote()
	local id = EMOTES[name]
	if not id then return end
	local lp = game:GetService("Players").LocalPlayer
	local char = lp.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	-- prefer Animator
	local animator = hum:FindFirstChildOfClass("Animator")
	pcall(function()
		local anim = Instance.new("Animation")
		anim.AnimationId = "rbxassetid://" .. tostring(id)
		local track
		if animator then
			track = animator:LoadAnimation(anim)
		else
			track = hum:LoadAnimation(anim)
		end
		track.Priority = Enum.AnimationPriority.Action4
		track.Looped = true
		track:Play(0.1)
		track:AdjustSpeed(tonumber(getgenv().EmoteSpeed) or 1)
		getgenv().CurrentEmoteTrack = track
	end)
end

