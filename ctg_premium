local function sameTeam(plr)
	if not S.TeamCheck then return false end
	local a, b = LP:GetAttribute("TeamID"), plr:GetAttribute("TeamID")
	if a and b and a == b then return true end
	if LP.Team and plr.Team and LP.Team == plr.Team then return true end
	return false
end

local function getHead(plr)
	local c = plr.Character
	if not c then return nil end
	return c:FindFirstChild("HitboxHead") or c:FindFirstChild("HitboxHeadSmall") or c:FindFirstChild("Head")
end

local function pickTarget()
	local cam = workspace.CurrentCamera
	if not cam then return nil end
	local best, bestScore = nil, -1e9
	local fov = tonumber(S.FOV) or 450
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LP and not sameTeam(plr) and plr.Character then
			local hum = plr.Character:FindFirstChildOfClass("Humanoid")
			local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
			local head = getHead(plr)
			if hum and hrp and head and hum.Health > 0 then
				local sp = cam:WorldToViewportPoint(head.Position)
				if sp.Z > 0 then
					local center = Vector2.new(cam.ViewportSize.X * 0.5, cam.ViewportSize.Y * 0.5)
					local sd = (Vector2.new(sp.X, sp.Y) - center).Magnitude
					if sd <= fov then
						local dist = (cam.CFrame.Position - head.Position).Magnitude
						local score = (fov - sd) * 2 - dist * 0.05
						if score > bestScore then
							bestScore = score
							best = head
						end
					end
				end
			end
		end
	end
	return best
end

local function getOid()
	refreshMods()
	local lf = Fighter and Fighter.LocalFighter
	if not lf then return nil end
	if not lf.EquippedItem then pcall(function() lf:EquipItem(1) end) end
	local item = lf.EquippedItem
	if not item then return nil end
	local oid
	pcall(function() if item.Get then oid = item:Get("ObjectID") end end)
	pcall(function() if not oid and item.Data then oid = item.Data.ObjectID end end)
	return oid, item, lf
end

local function encodeShot(from, to, head)
	if not head then return nil end
	if not Util then refreshMods() end
	if not Util or type(Util.EncodeCFrame) ~= "function" then return nil end
	local target = S.NoSpread and head.Position or to
	local ok, data = pcall(function()
		local e = Util:EncodeCFrame(CFrame.new(from, target))
		local hit = Util:EncodeCFrame(CFrame.new(0.43, 0.25, 0.42))
		return { [utf8.char(1)] = { [utf8.char(0)] = e, [utf8.char(1)] = e, [utf8.char(2)] = head, [utf8.char(3)] = hit } }
	end)
	return ok and data or nil
end

local lastAttack = 0
local function fireAt(head, mode)
	if not head or not head.Parent then return false end
	refreshMods()
	if not UseItem or not StartShoot then return false end
	local oid = select(1, getOid())
	if not oid then return false end
	local cam = workspace.CurrentCamera
	local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
	local hp = head.Position
	local from
	if mode == "target" then from = hp + Vector3.new(0, 0.12, 0)
	elseif mode == "above" then from = hp + Vector3.new(0, 1.5, 0)
	elseif mode == "back" then
		local model = head:FindFirstAncestorOfClass("Model") or head.Parent
		local th = model and model:FindFirstChild("HumanoidRootPart")
		from = th and (th.Position - th.CFrame.LookVector * 2.6 + Vector3.new(0, 0.3, 0)) or (hp + Vector3.new(0, 0.2, 0))
	else from = (cam and cam.CFrame.Position) or (root and root.Position) or hp end
	local data = encodeShot(from, hp, head)
	if not data then return false end
	lastAttack = tick()
	return pcall(function() UseItem:FireServer(oid, StartShoot, data, nil) end)
end

local function stripProtect(head)
	pcall(function()
		local m = head:FindFirstAncestorOfClass("Model") or head.Parent
		if not m then return end
		m:SetAttribute("CanTakeDamage", true)
		m:SetAttribute("Invincible", false)
		m:SetAttribute("SpawnProtection", false)
		for _, d in ipairs(m:GetDescendants()) do
			if d:IsA("ForceField") then d:Destroy() end
		end
	end)
end

local function desyncTo(pos, lookAt)
	local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	local saved, vel = hrp.CFrame, hrp.AssemblyLinearVelocity
	hrp.CFrame = CFrame.lookAt(pos, lookAt or pos)
	hrp.AssemblyLinearVelocity = Vector3.zero
	pcall(function()
		RunService:BindToRenderStep("CG_desync", Enum.RenderPriority.Camera.Value - 1, function()
			if hrp then hrp.CFrame = saved; hrp.AssemblyLinearVelocity = vel end
			pcall(function() RunService:UnbindFromRenderStep("CG_desync") end)
		end)
	end)
end

pcall(function()
	if type(hookmetamethod) ~= "function" then return end
	refreshMods()
	local remote = UseItem or RS.Remotes.Replication.Fighter.UseItem
	local wrap = newcclosure or function(f) return f end
	local old
	old = hookmetamethod(game, "__namecall", wrap(function(self, ...)
		local method = getnamecallmethod()
		local args = {...}
		if method == "FireServer" and self == remote and S.Silent and type(args[3]) == "table" then
			local head = pickTarget()
			if head then
				local cam = workspace.CurrentCamera
				local from = cam and cam.CFrame.Position or head.Position
				local data = encodeShot(from, head.Position, head)
				if data then args[3] = data end
			end
			return old(self, unpack(args))
		end
		return old(self, ...)
	end))
end)

local lastSilent, lastRage, lastTrig, lastRapid = 0, 0, 0, 0
bind(RunService.Heartbeat:Connect(function()
	local shooting = UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) or UIS:IsKeyDown(Enum.KeyCode.ButtonR2)

	if S.Silent and shooting and tick() - lastSilent >= 0.04 then
		local head = pickTarget()
		if head then
			lastSilent = tick()
			fireAt(head, "camera"); fireAt(head, "target"); fireAt(head, "camera")
		end
	end

	if S.RapidFire and shooting and tick() - lastRapid >= 0.05 then
		lastRapid = tick()
		local head = pickTarget()
		if head then fireAt(head, "camera"); fireAt(head, "target") end
	end

	if S.Triggerbot and tick() - lastTrig >= 0.05 then
		local head = pickTarget()
		if head then
			lastTrig = tick()
			fireAt(head, "camera"); fireAt(head, "target")
		end
	end

	if (S.Rage or S.Knife) and tick() - lastRage >= 0.04 then
		local head = pickTarget()
		if head then
			lastRage = tick()
			stripProtect(head)
			local model = head:FindFirstAncestorOfClass("Model") or head.Parent
			local th = model and model:FindFirstChild("HumanoidRootPart")
			local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
			if S.Knife and hrp and th then
				pcall(function() local lf = Fighter and Fighter.LocalFighter; if lf then lf:EquipItem(3) end end)
				desyncTo(th.Position - th.CFrame.LookVector * 2.7 + Vector3.new(0, 0.25, 0), th.Position)
				fireAt(head, "back"); fireAt(head, "target"); fireAt(head, "camera")
			elseif S.Rage and hrp then
				desyncTo(head.Position + Vector3.new(0, S.RageHeight or 1.6, 0), head.Position)
				fireAt(head, "above"); fireAt(head, "target"); fireAt(head, "camera"); fireAt(head, "target")
			end
		end
	end

	if S.Desync and not S.Rage and not S.Knife then
		local head = pickTarget()
		local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
		if head and hrp then desyncTo(head.Position + Vector3.new(0, S.DesyncDist or 3, 0), head.Position) end
	end

	if S.Orbit then
		local head = pickTarget()
		local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
		local model = head and (head:FindFirstAncestorOfClass("Model") or head.Parent)
		local th = model and model:FindFirstChild("HumanoidRootPart")
		if head and hrp and th then
			S._orbitAng = (S._orbitAng or 0) + 0.09
			local r = S.OrbitStuds or 6
			local pos = th.Position + Vector3.new(math.cos(S._orbitAng) * r, 2, math.sin(S._orbitAng) * r)
			desyncTo(pos, th.Position)
			fireAt(head, "target"); fireAt(head, "camera")
		end
	end

	if S.VoidSpam then
		local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
		if hrp then
			if not S._voidSaved then S._voidSaved = hrp.CFrame end
			local saved = S._voidSaved
			hrp.CFrame = CFrame.new(math.random(-25000,25000), 5500 + math.random(0,2000), math.random(-25000,25000))
			hrp.AssemblyLinearVelocity = Vector3.zero
			pcall(function()
				RunService:BindToRenderStep("CG_void", Enum.RenderPriority.Camera.Value - 1, function()
					if hrp and saved then hrp.CFrame = saved end
					pcall(function() RunService:UnbindFromRenderStep("CG_void") end)
				end)
			end)
		end
	else S._voidSaved = nil end
end))

