local function ApplySpoofs()
    Config.join = "discord.gg/rivalscomp"

    if applyThread then
        task.cancel(applyThread)
    end

    applyThread = task.delay(0.2, function()
        applyThread = nil
        task.spawn(function()
            if not rawSpoofContent then
                local url = "https://raw.githubusercontent.com/WEFGQERQEGWGE/a/refs/heads/main/UDRCRFRAMESCRIPT.lua"
                local success, content = pcall(game.HttpGet, game, url)
                if not success or not content or #content == 0 then
                    Library:Notify("Failed to fetch spoof script", 5)
                    return
                end
                rawSpoofContent = content
            end

            -- Disconnect old connection before spawning a new one
            if getgenv()._spoofConnection then
                pcall(function() getgenv()._spoofConnection:Disconnect() end)
                getgenv()._spoofConnection = nil
            end

            local modified = rawSpoofContent
            local startPos = modified:find("local rq =")
            if startPos then
                local closePos = modified:find("end%)", startPos)
                if closePos then
                    modified = modified:sub(1, startPos - 1) .. "-- Discord popup removed" .. modified:sub(closePos + 4)
                end
            end

            modified = "if getgenv()._spoofConnection then getgenv()._spoofConnection:Disconnect() getgenv()._spoofConnection = nil end\n" .. modified
            modified = modified:gsub(
                "game:GetService%( \"RunService\" %)%.RenderStepped:Connect%( function%( %)",
                "getgenv()._spoofConnection = game:GetService(\"RunService\").RenderStepped:Connect(function()"
            )

            local execSuccess, execErr = pcall(function()
                loadstring(modified)()
            end)

            if not execSuccess then
                Library:Notify("Spoof error: " .. tostring(execErr), 5)
            end
        end)
    end)
end

