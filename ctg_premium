local function isSemiWeapon(item)
	if not item then return false end
	local name = ""
	pcall(function()
		name = tostring(item.Name or (item.Get and item:Get("Name")) or "")
	end)
	name = string.lower(name)
	local autoKeys = {
		"smg", "rifle", "assault", "ak", "m4", "tommy", "minigun", "lmg",
		"auto", "spray", "uzi", "mp5", "mp7", "vector", "p90", "scar",
		"carbine", "machine", "burst",
	}
	for _, k in ipairs(autoKeys) do
		if string.find(name, k, 1, true) then return false end
	end
	local semiKeys = {
		"pistol", "revolver", "deagle", "handgun", "glock", "m1911",
		"magnum", "python", "desert", "usp", "beretta", "colt",
		"sidearm", "flare",
	}
	for _, k in ipairs(semiKeys) do
		if string.find(name, k, 1, true) then return true end
	end
	local auto = false
	pcall(function()
		local info = item.Info
		if type(info) == "table" then
			if info.Automatic == true or info.IsAutomatic == true or info.FullAuto == true then
				auto = true
			end
			local mode = tostring(info.FireMode or info.ShootMode or info.Mode or ""):lower()
			if mode:find("auto") or mode:find("spray") then auto = true end
			if mode:find("semi") or mode:find("single") then auto = false end
		end
	end)
	if auto then return false end
	return true
end

local function forceZeroInfo(info)
	if type(info) ~= "table" then return end
	for k, v in pairs(info) do
		if type(v) == "number" then
			local lk = string.lower(tostring(k))
			if string.find(lk, "cool") or string.find(lk, "delay") or string.find(lk, "rate")
				or string.find(lk, "interval") or string.find(lk, "ready") or string.find(lk, "wait")
				or string.find(lk, "shoot") or string.find(lk, "attack") or string.find(lk, "swing")
				or string.find(lk, "fire") or string.find(lk, "shot") then
				info[k] = 0
			end
		end
	end
	for _, k in ipairs({
		"ShootCooldown", "ShotCooldown", "FireCooldown", "FireRate", "Cooldown",
		"AttackCooldown", "SwingCooldown", "HitCooldown", "DelayBetweenShots",
		"TimeBetweenShots", "MinShootInterval", "NextShotTime",
	}) do
		if type(info[k]) == "number" then
			info[k] = 0
		end
	end
end

