    local offset = CFrame.new(math.sin(rad) * radius, height, math.cos(rad) * radius)
    local desyncPos = (targetRoot.CFrame * offset).Position
    -- knife: stick closer behind
    if knifeOn and not rageOn then
        desyncPos = (targetRoot.CFrame * CFrame.new(0, 0.5, 2.2)).Position
    end
