local function showHitUI(text)
	task.spawn(function()
		local dmg = tostring(text):match("%d+") or text
		local side = (math.random() > 0.5) and 1 or -1
		local lab = Instance.new("TextLabel")
		lab.AnchorPoint = Vector2.new(0.5, 0.5)
		lab.Size = UDim2.fromOffset(120, 40)
		lab.Position = UDim2.new(0.5, side * math.random(20, 50), 0.45, math.random(-20, 20))
		lab.BackgroundTransparency = 1
		lab.Font = Enum.Font.GothamBold
		lab.TextSize = 22
		lab.TextStrokeTransparency = 0.3
		lab.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
		lab.TextColor3 = Color3.fromRGB(255, 80, 80)
		lab.Text = tostring(dmg)
		lab.ZIndex = 50
		lab.Parent = ScreenGui
		local t0 = tick()
		local life = 0.85
		local rot = side * math.random(25, 55)
		local spread = side * math.random(70, 120)
		while tick() - t0 < life do
			local a = (tick() - t0) / life
			local y = -40 * a - 20 * math.sin(a * math.pi)
			local x = spread * a
			lab.Position = UDim2.new(0.5, x + side * 20, 0.45, y)
			lab.Rotation = rot * a * 0.6
			lab.TextTransparency = math.max(0, (a - 0.55) / 0.45)
			lab.TextStrokeTransparency = 0.3 + lab.TextTransparency * 0.7
			task.wait()
		end
		lab:Destroy()
	end)
end

