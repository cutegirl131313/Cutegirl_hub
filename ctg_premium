			mods()
			if util and enum and FC then break end
			task.wait(0.5)
		end
	end)

	local lastFire, lastJitter, lastCollect, lastScan = 0, 0, 0, 0
	local lockedRoot, jitterOff = nil, Vector3.zero
	local hidePhase, phaseStart = "hit", tick()
	local savedCF, hideCF = nil, nil
	local tModel, tRoot, tHead = nil, nil, nil

	local function cfg()
		return {
			on = S.ZombieKill == true,
			rate = tonumber(S.ZombieFireRate) or 0.05,
			dist = tonumber(S.ZombieRange) or 500,
			lock = S.ZombieLock == true,
			lockH = tonumber(S.ZombieLockOffset) or 14.5,
			lockTol = tonumber(S.ZombieLockTol) or 0.1,
			jitter = S.ZombieJitter == true,
			jR = tonumber(S.ZombieJitterRadius) or 14,
			jI = tonumber(S.ZombieJitterInterval) or 0.3,
			noclip = S.ZombieNoclip == true,
			collect = S.ZombieCollect ~= false,
			hp = S.ZombieCollectHP ~= false,
			ammo = S.ZombieCollectAmmo ~= false,
			cInt = tonumber(S.ZombieCollectInterval) or 0.1,
			hide = S.ZombieHide == true,
			hitT = tonumber(S.ZombieHitTime) or 0.35,
			hideT = tonumber(S.ZombieHideTime) or 0.35,
			hideD = tonumber(S.ZombieHideDist) or 500,
		}
	end

	local function isDangerZombie(model)
		if not model then return false end
		local n = string.lower(model.Name or "")
		-- explode / skeleton / bomber / grenade style
		local keys = {
			"explod", "boom", "bomb", "grenade", "tnt", "blast", "suic",
			"skeleton", "skel", "bone", "skull", "throw", "bomber",
			"c4", "dynamite", "volatile", "nuclear", "barrel"
		}
		for _, k in ipairs(keys) do
			if n:find(k, 1, true) then return true end
		end
		-- check children names too
		local ok, desc = pcall(function() return model:GetChildren() end)
		if ok then
			for _, ch in ipairs(desc) do
				local cn = string.lower(ch.Name or "")
				for _, k in ipairs(keys) do
					if cn:find(k, 1, true) then return true end
				end
			end
		end
		return false
	end

	local function noclip(state)
		local char = LP.Character
		if not char then return end
		for _, p in ipairs(char:GetDescendants()) do
			if p:IsA("BasePart") then
				if state then p.CanCollide = false
				elseif p.Name ~= "HumanoidRootPart" then p.CanCollide = true end
			end
		end
	end

	LP.CharacterAdded:Connect(function(c)
		c:WaitForChild("HumanoidRootPart", 5)
		task.wait(0.1)
		if S.ZombieNoclip then noclip(true) end
		hidePhase, phaseStart = "hit", tick()
		savedCF, hideCF, lockedRoot = nil, nil, nil
	end)

	-- exact same target pick as tower-rage-1 (GetDescendants), throttled only by time
	local function scanTargets()
		local c = cfg()
		local char = LP.Character
		local myRoot = char and char:FindFirstChild("HumanoidRootPart")
		if not myRoot then
			tModel, tRoot, tHead = nil, nil, nil
			return
		end
		local closestModel, closestRoot, closestHead = nil, nil, nil
		local closestDist = c.dist -- MaxDistance (same as original)
		for _, obj in ipairs(Workspace:GetDescendants()) do
			if obj:IsA("Model") and obj ~= char then
				local pRoot = obj:FindFirstChild("HumanoidRootPart")
				local pHead = obj:FindFirstChild("HitboxHead")
					or obj:FindFirstChild("Head")
					or obj:FindFirstChild("HitboxHeadSmall")
				local pHum = obj:FindFirstChildWhichIsA("Humanoid")
				if pRoot and pHead and pHum and pHum.Health > 0 then
					if not Players:GetPlayerFromCharacter(obj) then
						local dist = (myRoot.Position - pRoot.Position).Magnitude
						if dist < closestDist then
							closestDist = dist
							closestModel = obj
							closestRoot = pRoot
							closestHead = pHead
						end
					end
				end
			end
		end
		tModel, tRoot, tHead = closestModel, closestRoot, closestHead
	end

	local function doCollect()
		local c = cfg()
		if not c.collect then return end
		if tick() - lastCollect < c.cInt then return end
		lastCollect = tick()
		local char = LP.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hrp or not hum or hum.Health <= 0 then return end
		local wantHP = c.hp and hum.Health < hum.MaxHealth
		local wantAmmo = c.ammo
		if not wantHP and not wantAmmo then return end
		if not firetouchinterest then return end
		for _, obj in ipairs(Workspace:GetChildren()) do
			if obj.Name == "_drop" and obj:IsA("BasePart") then
				local isHP = obj:FindFirstChild("Health") ~= nil
				local isAmmo = obj:FindFirstChild("Ammo") ~= nil or obj:FindFirstChild("AmmoBalanced") ~= nil
				if (wantHP and isHP) or (wantAmmo and isAmmo) then
					pcall(function()
						firetouchinterest(hrp, obj, 0)
						firetouchinterest(hrp, obj, 1)
					end)
				end
			end
		end
	end

	local function lockAbove(root, danger)
		local c = cfg()
		local my = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
		if not my or not root or not root.Parent then return end
		-- explode/skeleton: stay HIGH + side offset so AOE / throws miss
		local height = c.lockH
		local side = Vector3.zero
		if danger then
			height = math.max(height, 22)
			local ang = tick() * 4
			side = Vector3.new(math.cos(ang) * 12, 0, math.sin(ang) * 12)
		end
		local ideal = root.Position + Vector3.new(0, height, 0) + side
		if c.jitter or danger then ideal = ideal + jitterOff end
		local changed = lockedRoot ~= root
		lockedRoot = root
		local tol = danger and 1.5 or c.lockTol
		if not changed and (my.Position - ideal).Magnitude < tol then return end
		my.CFrame = CFrame.new(ideal) * (my.CFrame - my.CFrame.Position)
		my.AssemblyLinearVelocity = Vector3.zero
	end

	local function updateJitter(root)
		local c = cfg()
		if not c.jitter then jitterOff = Vector3.zero; return end
		if tick() - lastJitter < c.jI then return end
		lastJitter = tick()
		local amount = (math.random() * 2 - 1) * c.jR
		jitterOff = root and (root.CFrame.RightVector * amount) or Vector3.new(amount, 0, 0)
	end

	local function fireHead(head)
		mods()
		if not util or not enum or not FC then return end
		local lf = FC.LocalFighter
		if not lf then return end
		if not lf.EquippedItem then
			pcall(function() lf:EquipItem(1) end)
		end
		if not lf.EquippedItem then return end
		local oid
		pcall(function() oid = lf.EquippedItem:Get("ObjectID") end)
		if not oid then return end
		local se
		pcall(function() se = enum:ToEnum("StartShooting") end)
		if not se then return end
		-- prefer real head hitbox
		local model = head:FindFirstAncestorOfClass("Model") or head.Parent
		if model then
			local h = model:FindFirstChild("HitboxHead") or model:FindFirstChild("HitboxHeadSmall") or model:FindFirstChild("Head")
			if h then head = h end
		end
		local targetPos = head.Position
		-- CLOSE origins only (far origin = no register). same as working rage style
		local origins = {
			targetPos + Vector3.new(0, 0.05, 0),
			targetPos + Vector3.new(0, 0.15, 0),
			targetPos + Vector3.new(0, 0.35, 0),
			targetPos + Vector3.new(0, 1, 0),
		}
		for _, originPos in ipairs(origins) do
			local aimCF = CFrame.lookAt(originPos, targetPos)
			local targetCF = head.CFrame
			local aimed = targetPos
			local objOff = head.CFrame:ToObjectSpace(CFrame.new(aimed))
			local data = {
				[utf8.char(1)] = {
					[utf8.char(0)] = util:EncodeCFrame(aimCF),
					[utf8.char(1)] = util:EncodeCFrame(targetCF),
					[utf8.char(2)] = head,
					[utf8.char(3)] = util:EncodeCFrame(objOff),
				}
			}
			pcall(function()
				RS.Remotes.Replication.Fighter.UseItem:FireServer(oid, se, data, nil)
			end)
		end
	end

	RunService.Heartbeat:Connect(function()
		if not S then return end
		local c = cfg()

		-- collect always when toggle on (usable without combat)
		doCollect()

		if c.noclip then pcall(noclip, true) end

		if not c.on then
			lockedRoot = nil
			return
		end

		local char = LP.Character
		local my = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not my or not hum or hum.Health <= 0 then
			lockedRoot = nil
			return
		end

		if tick() - lastScan >= 0 then
			lastScan = tick()
			scanTargets()
		end

		if c.hide and hidePhase == "hide" then
			if hideCF and (my.Position - hideCF.Position).Magnitude > 1 then
				my.CFrame = hideCF
			end
			if tick() - phaseStart >= c.hideT then
				if savedCF then my.CFrame = savedCF end
				savedCF, hideCF = nil, nil
				hidePhase, phaseStart = "hit", tick()
			end
			return
		end

		if c.hide then
			if not tRoot then
				hidePhase, phaseStart = "hit", tick()
				lockedRoot = nil
				return
			end
			if hidePhase == "hit" and tick() - phaseStart >= c.hitT then
				savedCF = my.CFrame
				local sign = (math.random() < 0.5) and -1 or 1
				hideCF = CFrame.new(my.Position + Vector3.new(sign * c.hideD, 0, 0)) * (my.CFrame - my.CFrame.Position)
				my.CFrame = hideCF
				hidePhase, phaseStart = "hide", tick()
				return
			end
		else
			if hidePhase == "hide" then
				if savedCF then my.CFrame = savedCF end
				savedCF, hideCF = nil, nil
				hidePhase, phaseStart = "hit", tick()
			end
		end

		if not tHead or not tRoot then
			lockedRoot = nil
			return
		end

		local danger = isDangerZombie(tModel)
		-- always noclip while fighting danger types
		if danger then pcall(noclip, true) end
		-- force jitter on danger
		if c.lock and (c.jitter or danger) then
			if danger then
				-- stronger jitter
				if tick() - lastJitter >= 0.12 then
					lastJitter = tick()
					local amount = (math.random() * 2 - 1) * math.max(c.jR, 16)
					jitterOff = tRoot.CFrame.RightVector * amount + Vector3.new(0, math.random() * 3, 0)
				end
			else
				updateJitter(tRoot)
			end
		end
		-- auto lock high on danger even if lock toggle off
		if c.lock or danger then
			lockAbove(tRoot, danger)
		else
			lockedRoot = nil
		end

		if tick() - lastFire < c.rate then return end
		lastFire = tick()
		fireHead(tHead)
	end)

	print("[tower-rage] fixed ready")
end)
