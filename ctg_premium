local function CG_encode(from, to, head)
	if typeof(from) ~= "Vector3" or typeof(to) ~= "Vector3" or not head then return nil end
	-- prefer main hub util
	local util = rawget(getfenv(), "__util") or CG_Util
	pcall(function() if not util then CG_refresh(); util = CG_Util end end)
	if not util or type(util.EncodeCFrame) ~= "function" then return nil end
	local ok, data = pcall(function()
		local e = util:EncodeCFrame(CFrame.new(from, to))
		local hit = util:EncodeCFrame(CFrame.new(0.43, 0.25, 0.42))
		return {
			[utf8.char(1)] = {
				[utf8.char(0)] = e,
				[utf8.char(1)] = e,
				[utf8.char(2)] = head,
				[utf8.char(3)] = hit,
			},
		}
	end)
	return (ok and data) or nil
end

