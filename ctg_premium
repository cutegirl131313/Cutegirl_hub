local function __isInvincible(player, pChar)
    if not player or not pChar then return true end
    if pChar:FindFirstChildOfClass("ForceField") then return true end
    local st = player:GetAttribute("SpawnTime")
    if st and (tick() - st) < 0.05 then return true end
    local ok, inv = pcall(function() return player:GetAttribute("Invincible") or player:GetAttribute("IsInvincible") end)
    if ok and inv then return true end
    local hum = pChar:FindFirstChildWhichIsA("Humanoid")
    if hum then
        local ok2, s = pcall(function() return hum:GetState() end)
        if ok2 and s == Enum.HumanoidStateType.Dead then return true end
    end
    return false
end

local function isProtected(char)
    if not char then return true end
    if char:FindFirstChild("InvincibilityParticles", true) then return true end
    if not char:FindFirstChild("HumanoidRootPart") then return true end
    if char:GetAttribute("SpawnProtection") or char:GetAttribute("Invincible") then return true end
    return false
end

local function isEntityInvincible(targetPlayer)
    local ok1, fighter = pcall(function()
        return __FighterController and __FighterController:GetFighter(targetPlayer)
    end)
    if not ok1 or not fighter then return false end
    local entity = fighter.Entity
    if not entity then return false end
    local ok2, inv = pcall(function() return entity:Get('IsInvincible') end)
    return ok2 and inv == true
end

local function isTargetInvincible(targetPlayer)
    if not targetPlayer then return true end
    if isProtected(targetPlayer.Character) then return true end
    if isEntityInvincible(targetPlayer) then return true end
    return false
end

local function __getClosestTarget()
    local char = __lplr.Character
    if not char then return nil, nil, nil end
    local myRoot = char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil, nil, nil end

    local closestPlayer, closestRoot, closestHead = nil, nil, nil
    local closestDist = 2000

    if getgenv().RagebotNPCOnly then
        for _, model in ipairs(Workspace:GetDescendants()) do
            if model:IsA("Model") then
                local hum = model:FindFirstChildOfClass("Humanoid")
                local pRoot = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso")
                local pHead = model:FindFirstChild("Head")
                
                if hum and hum.Health > 0 and pRoot and pHead and not Players:GetPlayerFromCharacter(model) then
                    local dist = (myRoot.Position - pRoot.Position).Magnitude
                    if dist < closestDist then
                        closestDist = dist
                        closestPlayer = nil
                        closestRoot = pRoot
                        closestHead = pHead
                    end
                end
            end
        end
    else
        for _, player in __plrs:GetPlayers() do
            if player == __lplr then continue end
            
            if not getgenv().RagebotFFA then
                if not __isEnemy(player) then continue end
            end
            
            local pChar = player.Character
            if not pChar then continue end
            
            if getgenv().RagebotFFA then
                if isTargetInvincible(player) then continue end
            else
                if __isInvincible(player, pChar) then continue end
            end
            
            local pRoot = pChar:FindFirstChild("HumanoidRootPart")
            local pHead = pChar:FindFirstChild("Head")
            local pHum = pChar:FindFirstChildWhichIsA("Humanoid")
            if not (pRoot and pHead and pHum and pHum.Health > 0) then continue end
            local dist = (myRoot.Position - pRoot.Position).Magnitude
            if dist < closestDist then
                closestDist = dist
                closestPlayer = player
                closestRoot = pRoot
                closestHead = pHead
            end
        end
    end

    return closestPlayer, closestRoot, closestHead
end

