local function _isImmune(plr, char)
	if not S.ImmunityCheck then return false end
	char = char or (plr and plr.Character)
	if not char then return true end
	-- ForceField
	if char:FindFirstChildOfClass("ForceField") then return true end
	-- common attributes / spawn protection flags
	local immuneAttrs = {
		"Immune", "IsImmune", "Invincible", "Invulnerable", "GodMode",
		"SpawnProtection", "Protected", "NoDamage", "CanBeDamaged",
	}
	for _, a in ipairs(immuneAttrs) do
		local v = nil
		pcall(function() v = char:GetAttribute(a) end)
		if v == true then return true end
		if a == "CanBeDamaged" and v == false then return true end
		pcall(function()
			if plr then
				local pv = plr:GetAttribute(a)
				if pv == true then v = true end
				if a == "CanBeDamaged" and pv == false then v = true end
			end
		end)
		if v == true and a ~= "CanBeDamaged" then return true end
		if a == "CanBeDamaged" and v == false then return true end
	end
	-- humanoid state sometimes used
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		local ok, st = pcall(function() return hum:GetState() end)
		if ok and st == Enum.HumanoidStateType.Physics then
			-- not always immune; skip
		end
	end
	return false
end

