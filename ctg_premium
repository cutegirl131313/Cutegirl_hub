-- auto reload
local tReload = 0
bind(RunService.Heartbeat:Connect(function()
	if not S.AutoReload or tick() - tReload < 0.4 then return end
	local id, item, lf = oid()
	if not item then return end
	local need = false
	pcall(function()
		local a = item.Get and item:Get("Ammo")
		if a ~= nil and a <= 0 then need = true end
		if item.Data and item.Data.Ammo ~= nil and item.Data.Ammo <= 0 then need = true end
	end)
	if need then
		tReload = tick()
		pcall(function() if item.Reload then item:Reload() end end)
		pcall(function() if lf and lf.Reload then lf:Reload() end end)
		pcall(function() if ReloadEnum and id and UseItem then UseItem:FireServer(id, ReloadEnum, nil, nil) end end)
	end
end))

