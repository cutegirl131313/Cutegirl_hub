RunService.RenderStepped:Connect(function()
	if not S.ThirdPerson then return end
	local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
	local cam = workspace.CurrentCamera
	if not hrp or not cam then return end
	local off = Vector3.new(S.TP_X or 2.5, S.TP_Y or 1.5, S.TP_Z or 6)
	if S.TP_Ray then
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { LP.Character }
		local hit = workspace:Raycast(hrp.Position, hrp.CFrame:VectorToWorldSpace(off), params)
		if hit then
			local localHit = hrp.CFrame:VectorToObjectSpace(hit.Position - hrp.Position)
			local mag = localHit.Magnitude
			if mag > 0.3 then off = localHit.Unit * (mag - 0.3) end
		end
	end
	local world = hrp.CFrame:PointToWorldSpace(off)
	cam.CameraType = Enum.CameraType.Scriptable
	cam.CFrame = CFrame.lookAt(world, hrp.Position + Vector3.new(0, 1.5, 0))
	if LP.Character then
		for _, p in ipairs(LP.Character:GetDescendants()) do
			if p:IsA("BasePart") then p.LocalTransparencyModifier = 0 end
		end
	end
end)

