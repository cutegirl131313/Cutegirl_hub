local function startAntiAim()
    if antiAimConnection then return end

    antiAimConnection = RunService.RenderStepped:Connect(function(dt)
        if not getgenv().AntiAimEnabled then return end

        local char = Player.Character
        if not char then return end

        local head = char:FindFirstChild("Head")
        local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
        if not head or not torso then return end

        headOffset = headOffset + (dt * 3 * headDirection)

        if headOffset >= 1.2 then
            headDirection = -1
        elseif headOffset <= -1.8 then
            headDirection = 1
        end

        head.CFrame = torso.CFrame * CFrame.new(0, headOffset, 0)
    end)
end

local function stopAntiAim()
    if antiAimConnection then
        antiAimConnection:Disconnect()
        antiAimConnection = nil
    end
    headOffset = 0
    headDirection = 1
end

