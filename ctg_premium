local function track(plr)
	if plr == LP then return end
	local function onChar(char)
		local hum = char:WaitForChild("Humanoid", 5)
		if not hum then return end
		local hp = hum.Health
		hum.HealthChanged:Connect(function(n)
			local d = hp - n; hp = n
			if d > 2 and tick() - lastAttack < 0.5 then hitFeedback(plr.Name, d) end
		end)
	end
	plr.CharacterAdded:Connect(onChar)
	if plr.Character then task.spawn(onChar, plr.Character) end
end
for _, p in ipairs(Players:GetPlayers()) do track(p) end
Players.PlayerAdded:Connect(track)

