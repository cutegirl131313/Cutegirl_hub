	end
	return true
end

local function partBelongsTo(char, inst)
	if not char or not inst then return false end
	return inst == char or inst:IsDescendantOf(char)
end

local function hasLOS(fromPos, toPos, targetChar)
	if not S.WallCheck then return true end
	if not fromPos or not toPos then return false end
	local dir = toPos - fromPos
	local dist = dir.Magnitude
	if dist < 0.35 then return true end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local filter = {}
	if LP.Character then table.insert(filter, LP.Character) end
	-- do NOT fully exclude targetChar: we need to know what we hit
	-- only exclude local accessories noise via local char
	params.FilterDescendantsInstances = filter
	params.IgnoreWater = true
	params.RespectCanCollide = false

	local result = Workspace:Raycast(fromPos, dir.Unit * dist, params)
	if not result then
		return true
	end
	-- clear only if first hit is the target character (or very close to head)
	if targetChar and partBelongsTo(targetChar, result.Instance) then
		return true
	end
	-- anything else = wall / prop / other player
	return false
end

local function canSilentTarget(head)
	if not head or not head.Parent then return false end
	local char = head:FindFirstAncestorOfClass("Model") or head.Parent
	local plr = char and Players:GetPlayerFromCharacter(char)
	if not plr or not validEnemy(plr) then return false end
	if not S.WallCheck then return true end

	local cam = Workspace.CurrentCamera
	local fromCam = cam and cam.CFrame.Position or head.Position
	local root = getRootPart and getRootPart()
	local fromRoot = root and root.Position or fromCam

	-- BOTH camera and root must see head, or at least one strict path
	local okCam = hasLOS(fromCam, head.Position, char)
	local okRoot = hasLOS(fromRoot, head.Position, char)
	return okCam or okRoot
end

local function getHead(plr)
	local c = plr.Character
	if not c then return nil end
	-- always prefer real head hitboxes for silent
	return c:FindFirstChild("HitboxHead")
		or c:FindFirstChild("HitboxHeadSmall")
		or c:FindFirstChild("HeadHitbox")
		or c:FindFirstChild("Head")
end

local function getNearest(ignoreWall)
	local root = getRootPart()
	local cam = Workspace.CurrentCamera
	if not root and not cam then return nil end
	local best, bd = nil, math.huge
	local from = (cam and cam.CFrame.Position) or root.Position
	for _, plr in ipairs(Players:GetPlayers()) do
		if validEnemy(plr) then
			local head = getHead(plr)
			local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
			if head and hrp then
				local okWall = true
				if not ignoreWall then
					okWall = hasLOS(from, head.Position, plr.Character)
				end
				if okWall then
					local d = (from - hrp.Position).Magnitude
					if d < bd then
						bd = d
						best = head
					end
				end
			end
		end
	end
	return best
end

local function getCrosshair(fov)
	local cam = Workspace.CurrentCamera
	if not cam then return nil end
	local best, bd = nil, (fov or 300)
	local center = cam.ViewportSize / 2
	local from = cam.CFrame.Position
	for _, plr in ipairs(Players:GetPlayers()) do
		if validEnemy(plr) then
			local head = getHead(plr)
			if head then
				local sp, on = cam:WorldToViewportPoint(head.Position)
				if on and sp.Z > 0 then
					local dist = (Vector2.new(sp.X, sp.Y) - Vector2.new(center.X, center.Y)).Magnitude
					if dist <= bd then
						local okWall = true
						if S.WallCheck then
							okWall = hasLOS(from, head.Position, plr.Character)
						end
						if okWall then
							bd = dist
							best = head
						end
					end
				end
			end
		end
	end
	return best
end

local function getTarget(ignoreWall, fov)
	local mode = S.TargetPriority or "Closest"
	if mode == "Crosshair" then
		return getCrosshair(fov or S.AimFOV or 300) or getNearest(ignoreWall)
	elseif mode == "LowHP" then
		local root = getRootPart()
		if not root then return nil end
		local best, bestHp = nil, math.huge
		local from = root.Position
		for _, plr in ipairs(Players:GetPlayers()) do
			if validEnemy(plr) then
				local head = getHead(plr)
				local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
				if head and hum then
					local okWall = ignoreWall or hasLOS(from, head.Position, plr.Character)
					if okWall and hum.Health < bestHp then
						bestHp = hum.Health
						best = head
					end
				end
			end
		end
		return best
	end
	return getNearest(ignoreWall)
end

local function encodeShot(from, to, head)
	if not Utility then return nil end
	-- force destination to head position if head part given
	if head and head.Position then
		to = head.Position
	end
	local look = CFrame.lookAt(from, to)
	local e = Utility:EncodeCFrame(look)
	local hitPart = head
	-- relative offset on head (center)
	local rel = CFrame.new(0, 0, 0)
	pcall(function()
		if head then
			rel = head.CFrame:ToObjectSpace(CFrame.new(to))
		end
	end)
	local relE = Utility:EncodeCFrame(rel)
	return {
		[utf8.char(1)] = {
			[utf8.char(0)] = e,
			[utf8.char(1)] = e,
			[utf8.char(2)] = hitPart,
			[utf8.char(3)] = relE,
		},
	}
end

local function forceHeadPart(part)
	if not part then return nil end
	local char = part:FindFirstAncestorOfClass("Model") or part.Parent
	if not char then return part end
	return char:FindFirstChild("HitboxHead")
		or char:FindFirstChild("HitboxHeadSmall")
		or char:FindFirstChild("HeadHitbox")
		or char:FindFirstChild("Head")
		or part
end

