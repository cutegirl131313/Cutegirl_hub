						if S.ESP_Skeleton and head and hrp then
							local function getPartPos(name)
								local pt = char:FindFirstChild(name)
								return pt and pt.Position or nil
							end
							local headPos = head.Position
							local upperTorso = getPartPos("UpperTorso") or getPartPos("Torso") or hrp.Position
							local lowerTorso = getPartPos("LowerTorso") or hrp.Position
							local leftHand = getPartPos("LeftHand") or getPartPos("Left Arm")
							local rightHand = getPartPos("RightHand") or getPartPos("Right Arm")
							local leftFoot = getPartPos("LeftFoot") or getPartPos("Left Leg")
							local rightFoot = getPartPos("RightFoot") or getPartPos("Right Leg")
