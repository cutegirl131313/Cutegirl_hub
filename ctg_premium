local function getFighter()
	refreshMods()
	if not FC then return nil end
	if FC.LocalFighter then return FC.LocalFighter end
	if type(FC.GetFighter) == "function" then
		local ok, f = pcall(FC.GetFighter, FC, LP)
		if ok then return f end
	end
