-- Auto Loadout: equip chosen weapons by name when possible
local function tryEquipNamed(lf, weaponName, slotIndex)
	if not weaponName or weaponName == "None" or not lf then return end
	pcall(function()
		-- try inventory search
		if lf.Items then
			for _, item in pairs(lf.Items) do
				local n = item.Name or (item.Get and item:Get("Name"))
				if n and string.lower(tostring(n)) == string.lower(weaponName) then
					if item.Equip then
						item:Equip()
						return
					end
				end
			end
		end
		-- fallback slot
		if lf.EquipItem then
			lf:EquipItem(slotIndex)
		end
	end)
end

