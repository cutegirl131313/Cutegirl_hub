end

local function getRootPart()
	local lf = getFighter()
	if lf and lf.Entity and lf.Entity.RootPart then
		return lf.Entity.RootPart
	end
	return LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
end

local function validEnemy(plr)
	if plr == LP then return false end
	local char = plr.Character
	if not char then return false end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hum or not hrp or hum.Health <= 0 then return false end
	if S.TeamCheck then
		local a, b = LP:GetAttribute("TeamID"), plr:GetAttribute("TeamID")
		if a ~= nil and b ~= nil and a == b then return false end
		local ok, same = pcall(function()
			return LP.Team ~= nil and plr.Team ~= nil and LP.Team == plr.Team
		end)
		if ok and same then return false end
	end
	return true
end

local function partBelongsTo(char, inst)
	if not char or not inst then return false end
	return inst == char or inst:IsDescendantOf(char)
end

local function hasLOS(fromPos, toPos, targetChar)
	if not S.WallCheck then return true end
	if not fromPos or not toPos then return false end
	local dir = toPos - fromPos
	local dist = dir.Magnitude
	if dist < 0.35 then return true end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local filter = {}
	if LP.Character then table.insert(filter, LP.Character) end
	-- do NOT fully exclude targetChar: we need to know what we hit
	-- only exclude local accessories noise via local char
	params.FilterDescendantsInstances = filter
	params.IgnoreWater = true
	params.RespectCanCollide = false

	local result = Workspace:Raycast(fromPos, dir.Unit * dist, params)
	if not result then
		return true
	end
	-- clear only if first hit is the target character (or very close to head)
	if targetChar and partBelongsTo(targetChar, result.Instance) then
		return true
	end
	-- anything else = wall / prop / other player
	return false
end

local function canSilentTarget(head)
	if not head or not head.Parent then return false end
	local char = head:FindFirstAncestorOfClass("Model") or head.Parent
	local plr = char and Players:GetPlayerFromCharacter(char)
	if not plr or not validEnemy(plr) then return false end
	if not S.WallCheck then return true end

	local cam = Workspace.CurrentCamera
	local fromCam = cam and cam.CFrame.Position or head.Position
	local root = getRootPart and getRootPart()
	local fromRoot = root and root.Position or fromCam

	-- BOTH camera and root must see head, or at least one strict path
	local okCam = hasLOS(fromCam, head.Position, char)
	local okRoot = hasLOS(fromRoot, head.Position, char)
	return okCam or okRoot
end

local function getHead(plr)
	local c = plr.Character
	if not c then return nil end
	-- always prefer real head hitboxes for silent
	return c:FindFirstChild("HitboxHead")
		or c:FindFirstChild("HitboxHeadSmall")
		or c:FindFirstChild("HeadHitbox")
		or c:FindFirstChild("Head")
end

local function getNearest(ignoreWall)
	local root = getRootPart()
	local cam = Workspace.CurrentCamera
	if not root and not cam then return nil end
	local best, bd = nil, math.huge
	local from = (cam and cam.CFrame.Position) or root.Position
	for _, plr in ipairs(Players:GetPlayers()) do
		if validEnemy(plr) then
			local head = getHead(plr)
			local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
			if head and hrp then
				local okWall = true
				if not ignoreWall then
					okWall = hasLOS(from, head.Position, plr.Character)
				end
				if okWall then
					local d = (from - hrp.Position).Magnitude
					if d < bd then
						bd = d
						best = head
					end
				end
			end
		end
	end
	return best
end

local function getCrosshair(fov)
	local cam = Workspace.CurrentCamera
	if not cam then return nil end
	local best, bd = nil, (fov or 300)
	local center = cam.ViewportSize / 2
	local from = cam.CFrame.Position
	for _, plr in ipairs(Players:GetPlayers()) do
		if validEnemy(plr) then
			local head = getHead(plr)
			if head then
				local sp, on = cam:WorldToViewportPoint(head.Position)
				if on and sp.Z > 0 then
					local dist = (Vector2.new(sp.X, sp.Y) - Vector2.new(center.X, center.Y)).Magnitude
					if dist <= bd then
						local okWall = true
						if S.WallCheck then
							okWall = hasLOS(from, head.Position, plr.Character)
						end
						if okWall then
							bd = dist
							best = head
						end
					end
				end
			end
		end
	end
	return best
end

local function getTarget(ignoreWall, fov)
	local mode = S.TargetPriority or "Closest"
	if mode == "Crosshair" then
		return getCrosshair(fov or S.AimFOV or 300) or getNearest(ignoreWall)
	elseif mode == "LowHP" then
		local root = getRootPart()
		if not root then return nil end
		local best, bestHp = nil, math.huge
		local from = root.Position
		for _, plr in ipairs(Players:GetPlayers()) do
			if validEnemy(plr) then
				local head = getHead(plr)
				local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
				if head and hum then
					local okWall = ignoreWall or hasLOS(from, head.Position, plr.Character)
					if okWall and hum.Health < bestHp then
						bestHp = hum.Health
						best = head
					end
				end
			end
		end
		return best
	end
	return getNearest(ignoreWall)
end

local -- Silent encode: camera-origin packet bent onto head hitbox (noscope works)
function encodeShot(from, to, head)
	if not Utility then return nil end
	if head and head:IsA("BasePart") then
		to = head.Position
	end
	from = from or (Workspace.CurrentCamera and Workspace.CurrentCamera.CFrame.Position) or to
	local look = CFrame.lookAt(from, to)
	local e = Utility:EncodeCFrame(look)
	local hitPart = head
	local relE
	pcall(function()
		local rel = CFrame.new()
		if head and head:IsA("BasePart") then
			-- center of head hitbox
			rel = head.CFrame:ToObjectSpace(CFrame.new(head.Position))
		end
		relE = Utility:EncodeCFrame(rel)
	end)
	if not relE then
		relE = Utility:EncodeCFrame(CFrame.new())
	end
	return {
		[utf8.char(1)] = {
			[utf8.char(0)] = e,
			[utf8.char(1)] = e,
			[utf8.char(2)] = hitPart,
			[utf8.char(3)] = relE,
		},
	}
end

local function forceHeadPart(part)
	if not part then return nil end
	local char = part:FindFirstAncestorOfClass("Model") or part.Parent
	if not char then return part end
	return char:FindFirstChild("HitboxHead")
		or char:FindFirstChild("HitboxHeadSmall")
		or char:FindFirstChild("HeadHitbox")
		or char:FindFirstChild("Head")
		or part
end

task.spawn(function()
	for _ = 1, 15 do
		refreshMods()
		if GunModule and GunModule.StartShooting then break end
		task.wait(0.4)
	end
	if not (GunModule and GunModule.StartShooting) then return end
	local old = GunModule.StartShooting
	GunModule.StartShooting = function(self, ...)
		local a, b, c, d, e = old(self, ...)
		if not S.Triggerbot and not S.SilentAim then
			return a, b, c, d, e
		end
		local isLocal = false
		pcall(function()
			local cf = self.ClientFighter
			if cf then
				if cf.IsLocalPlayer then
					isLocal = true
				elseif cf.Player == LP then
					isLocal = true
				end
			end
		end)
		if not isLocal or type(c) ~= "table" then
			return a, b, c, d, e
		end

		local opt = silentOpts()
		if not opt.on and not opt.trig then
			return a, b, c, d, e
		end
		-- Activation %
		if opt.chance < 100 and math.random(1, 100) > opt.chance then
			return a, b, c, d, e
		end
		-- Not Reloading
		if opt.notReload then
			local reloading = false
			pcall(function()
				local item = self.ClientFighter and self.ClientFighter.EquippedItem
				if item then
					local a1 = item:Get("Reloading")
					local a2 = item:Get("IsReloading")
					local a3 = item:Get("ReloadProgress")
					reloading = (a1 == true) or (a2 == true) or (type(a3) == "number" and a3 > 0)
				end
			end)
			if reloading then return a, b, c, d, e end
		end
		-- Scoped Only
		if opt.scopedOnly then
			local scoped = false
			pcall(function()
				local item = self.ClientFighter and self.ClientFighter.EquippedItem
				if item then
					scoped = item:Get("IsScoped") or item:Get("Scoped") or item:Get("ADS")
						or item:Get("Aiming") or item:Get("IsAiming") or false
				end
				-- camera FOV drop often means scoped
				local cam = Workspace.CurrentCamera
				if cam and cam.FieldOfView < 50 then scoped = true end
			end)
			if not scoped then return a, b, c, d, e end
		end

		local head
		if opt.on then
			local ignoreWall = not opt.wall
			local fov = opt.withinFov and opt.fov or 9999
			head = getCrosshair(fov)
			if not head then head = getTarget(ignoreWall, fov) end
			if not head then head = getNearest(ignoreWall) end
		elseif opt.trig then
			head = getCrosshair(opt.trigFov)
		end
		-- Force Head / Head Priority %
		if head then
			if opt.forceHead or opt.headPct >= 100 then
				head = forceHeadPart(head)
			elseif opt.headPct > 0 and math.random(1, 100) <= opt.headPct then
				head = forceHeadPart(head)
			end
			-- if force head failed, keep original part
		end

		if not head then
			return a, b, c, d, e
		end
		if opt.wall and not canSilentTarget(head) then
			return a, b, c, d, e
		end

		-- Silent: ALWAYS camera origin so noscope / remote head works
		if Utility then
			local pos = head.Position
			local cam = Workspace.CurrentCamera
			local from = (cam and cam.CFrame.Position) or pos
			-- slight multi-origin for sniper / lag compensation
			local origins = {
				from,
				pos + Vector3.new(0, 0.05, 0), -- wallbang-style glue
				from + Vector3.new(0, 0.1, 0),
			}
			pcall(function()
				local data = encodeShot(origins[1], pos, head)
				if data then
					local slot = data[utf8.char(1)]
					c[utf8.char(1)] = slot
					c[utf8.char(0)] = slot[utf8.char(0)]
					c[utf8.char(2)] = head
					c[1] = slot
					c[2] = head
				end
			end)
			d = true
			-- extra remote burst for reliability (silent only)
			if H().SilentAim and H().SilentManipulate ~= false then
				task.defer(function()
					pcall(function()
						refreshMods()
						if not (UseItem and EnumLibrary) then return end
						local se = EnumLibrary:ToEnum("StartShooting")
						local oid = nil
						pcall(function()
							local lf = getFighter and getFighter()
							if lf and lf.EquippedItem then
								oid = lf.EquippedItem:Get("ObjectID")
							end
						end)
						if not oid then return end
						for _, o in ipairs(origins) do
							local data = encodeShot(o, pos, head)
							if data then
								UseItem:FireServer(oid, se, data, nil)
							end
						end
					end)
				end)
			end
		end
		return a, b, c, d, e
	end
end)

