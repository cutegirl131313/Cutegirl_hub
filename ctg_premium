local jumps = 0
bind(UIS.JumpRequest:Connect(function()
	if S.InfJump then
		local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
		if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
	elseif S.DoubleJump then
		jumps += 1
		if jumps <= 2 then
			local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
			if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
		end
	end
end))
local function onChar(c)
	jumps = 0
	local hum = c:WaitForChild("Humanoid", 5)
	if hum then hum.StateChanged:Connect(function(_, n) if n == Enum.HumanoidStateType.Landed then jumps = 0 end end) end
end
if LP.Character then task.spawn(onChar, LP.Character) end
