local function stopEmote()
	pcall(function() if emoteTrack then emoteTrack:Stop(0.15); emoteTrack:Destroy(); emoteTrack = nil end end)
end
local function playEmote(name)
	stopEmote()
	local id = EMOTES[name]
	if not id then return end
	local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	pcall(function()
		local anim = Instance.new("Animation"); anim.AnimationId = "rbxassetid://" .. tostring(id)
		local animator = hum:FindFirstChildOfClass("Animator")
		emoteTrack = animator and animator:LoadAnimation(anim) or hum:LoadAnimation(anim)
		emoteTrack.Looped = true; emoteTrack.Priority = Enum.AnimationPriority.Action4
