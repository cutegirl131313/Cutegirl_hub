	local H = _G.HUB
	H.AutoReload = (H.AutoReload ~= false)
	H.AutoPickup = (H.AutoPickup ~= false)

	local ft = firetouchinterest
	local lastReload = 0

	local function sync()
		pcall(function()
			if type(S) == "table" then
				for _, k in ipairs({"AutoReload","AutoPickup"}) do
					if S[k] ~= nil then H[k] = S[k] end
				end
			end
		end)
	end

	local function getBodyPart()
		local c = LP.Character
		if not c then return nil end
		return c:FindFirstChild("HumanoidRootPart")
			or c:FindFirstChild("HitboxBody")
			or c:FindFirstChild("UpperTorso")
			or c:FindFirstChild("Torso")
	end

	local function isHealthPart(obj)
		local n = string.lower(obj.Name)
		return string.find(n, "health") or string.find(n, "heal") or string.find(n, "med")
			or string.find(n, "heart") or string.find(n, "hp") or string.find(n, "kit")
	end
	local function isAmmoPart(obj)
		local n = string.lower(obj.Name)
		return string.find(n, "ammo") or string.find(n, "bullet") or string.find(n, "mag")
			or string.find(n, "clip") or string.find(n, "shell")
	end

	local function touchPart(part, body)
		if not ft or not part or not body then return end
		pcall(function()
			ft(part, body, 0)
			ft(part, body, 1)
		end)
	end

	-- Auto Heal + Auto Ammo (throttled cache — no per-frame GetDescendants)
	local dropCache, lastDropScan = {}, 0
	RunService.Heartbeat:Connect(function()
		sync()
		if not H.AutoPickup then return end
		local body = getBodyPart()
		local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
		if not body then return end
		local needHeal = hum and hum.Health < hum.MaxHealth - 0.5
		local needAmmo = true

		if tick() - lastDropScan > 0.6 then
			lastDropScan = tick()
			local list = {}
			-- only scan direct children + 1 level (cheap)
			for _, obj in ipairs(Workspace:GetChildren()) do
				if obj:IsA("BasePart") then
					list[#list+1] = obj
				elseif obj:IsA("Model") or obj:IsA("Folder") then
					for _, c in ipairs(obj:GetChildren()) do
						if c:IsA("BasePart") then list[#list+1] = c end
						if c:IsA("Model") then
							for _, c2 in ipairs(c:GetChildren()) do
								if c2:IsA("BasePart") then list[#list+1] = c2 end
							end
						end
					end
				end
			end
			dropCache = list
		end

		for i = 1, #dropCache do
			local obj = dropCache[i]
			if obj and obj.Parent then
				local dist = (obj.Position - body.Position).Magnitude
				if dist < 60 then
					local n = string.lower(obj.Name)
					local isH = isHealthPart(obj)
					local isA = isAmmoPart(obj)
					if (needHeal and isH) or isA or n:find("pickup") or n:find("drop") then
						touchPart(obj, body)
					end
				end
			end
		end
	end)

	-- Auto Reload (Kicia: UseItem StartReloading)
	RunService.Heartbeat:Connect(function()
		sync()
		if not H.AutoReload then return end
		if tick() - lastReload < 0.5 then return end

		pcall(function()
			-- need Utility / EnumLibrary / UseItem from hub
			if not (Utility and EnumLibrary and UseItem) then
				-- try refresh
				if type(refreshMods) == "function" then refreshMods() end
			end
			if not (Utility and EnumLibrary and UseItem) then return end

			local lf = nil
			pcall(function()
				if type(getFighter) == "function" then lf = getFighter() end
			end)
			if not lf then
				pcall(function()
					local FC = require(LP.PlayerScripts.Controllers.FighterController)
					lf = FC.LocalFighter or (FC.GetFighter and FC:GetFighter(LP))
				end)
			end
			if not lf or not lf.EquippedItem then return end
			local item = lf.EquippedItem

			local ammo, maxAmmo, reserve, reloading
			pcall(function()
				ammo = item:Get("Ammo") or item:Get("AmmoInClip")
				maxAmmo = item:Get("MaxAmmo") or item:Get("ClipSize") or item:Get("MagazineSize")
				reserve = item:Get("AmmoReserve") or item:Get("ReserveAmmo") or item:Get("StoredAmmo")
				reloading = item:Get("Reloading") or item:Get("IsReloading")
			end)
			if reloading then return end
			if type(ammo) ~= "number" then return end
			-- reload when empty or under 20%
			local need = false
			if type(maxAmmo) == "number" and maxAmmo > 0 then
				need = ammo <= 0 or ammo < maxAmmo * 0.15
			else
				need = ammo <= 0
			end
			if not need then return end
			if type(reserve) == "number" and reserve <= 0 then return end

			local oid
			pcall(function() oid = item:Get("ObjectID") or item.ObjectId end)
			if not oid then return end

			local se
			pcall(function() se = EnumLibrary:ToEnum("StartReloading") end)
			if not se then
				pcall(function() se = EnumLibrary:ToEnum("Reload") end)
			end
			if not se then return end

			local Reload = nil
			pcall(function()
				if Utility.Encode then Reload = Utility:Encode("Reload") end
			end)
			-- Kicia packet shape
			local payload
			if Reload ~= nil then
				payload = { ["\1"] = Reload, ["\2"] = Reload }
			else
				payload = { ["\1"] = "Reload", ["\2"] = "Reload" }
			end
			pcall(function()
				UseItem:FireServer(oid, se, payload, nil)
			end)
			lastReload = tick()
		end)
	end)

	print("[CuteGirl] Kicia AutoHeal/AutoReload loaded")
end)


