				end
				hrp.CFrame = RealCFrame
				if RealVelocity then
					hrp.AssemblyLinearVelocity = RealVelocity
				end
				RealCFrame = nil
				RealVelocity = nil
			end
		end)
	end)

	RunService.Heartbeat:Connect(function()
		local S = _G.HUB
