		local firetouch = firetouchinterest
		if not firetouch then return end
		for _, obj in ipairs(Workspace:GetChildren()) do
			if obj.Name == "_drop" and obj:IsA("BasePart") then
				local isHP = obj:FindFirstChild("Health") ~= nil
				local isAmmo = obj:FindFirstChild("Ammo") ~= nil or obj:FindFirstChild("AmmoBalanced") ~= nil
				if (wantHP and isHP) or (wantAmmo and isAmmo) then
					pcall(function()
						firetouch(hrp, obj, 0)
						firetouch(hrp, obj, 1)
					end)
				end
			end
		end
	end

	local skelWords = { "skel", "bone", "skull", "grenade", "explod", "bomb", "rocket", "projectile", "throw", "orb", "blast" }
	local function isDangerName(n)
		n = string.lower(tostring(n or ""))
		for _, w in ipairs(skelWords) do
			if string.find(n, w, 1, true) then return true end
		end
		return false
	end
	RunService.Heartbeat:Connect(function()
		local C = cfg()
		if not C.AntiSkel then return end
		local hrp = lplr.Character and lplr.Character:FindFirstChild("HumanoidRootPart")
		if not hrp then return end
		local pos = (RealCFrame and RealCFrame.Position) or hrp.Position
		for _, obj in ipairs(Workspace:GetChildren()) do
			if isDangerName(obj.Name) and obj:IsA("BasePart") and (obj.Position - pos).Magnitude < 50 then
				pcall(function()
					obj.CanTouch = false
					obj.CanQuery = false
					obj.Transparency = 1
				end)
			elseif obj:IsA("Model") or obj:IsA("Folder") then
				for _, c in ipairs(obj:GetChildren()) do
					if isDangerName(c.Name) or isDangerName(obj.Name) then
						local p = c:IsA("BasePart") and c or c:FindFirstChildWhichIsA("BasePart")
						if p and (p.Position - pos).Magnitude < 50 then
							pcall(function()
								if c:IsA("BasePart") then
									c.CanTouch = false
									c.CanQuery = false
									c.Transparency = 1
								end
								for _, d in ipairs(c:GetDescendants()) do
									if d:IsA("Explosion") then d:Destroy() end
									if d:IsA("BasePart") then
										d.CanTouch = false
										d.CanQuery = false
									end
								end
							end)
						end
					end
				end
			end
		end
	end)

	local function fireShots(localFighter, targetHead, originPos)
		local origins = {
			originPos,
			targetHead.Position + Vector3.new(0, 0.2, 0),
			targetHead.Position + Vector3.new(0, 0.5, 0),
			targetHead.Position + Vector3.new(0, 1.0, 0),
			targetHead.Position,
		}
		for _, o in ipairs(origins) do
			local aimCF = CFrame.lookAt(o, targetHead.Position)
			local objSpace = targetHead.CFrame:ToObjectSpace(CFrame.new(targetHead.Position))
			local cameradata = {
				[utf8.char(1)] = {
					[utf8.char(0)] = util:EncodeCFrame(aimCF),
					[utf8.char(1)] = util:EncodeCFrame(targetHead.CFrame),
					[utf8.char(2)] = targetHead,
					[utf8.char(3)] = util:EncodeCFrame(objSpace),
				},
			}
			pcall(function()
				ReplicatedStorage.Remotes.Replication.Fighter.UseItem:FireServer(
					localFighter.EquippedItem:Get("ObjectID"),
					enum:ToEnum("StartShooting"),
					cameradata,
					nil
				)
			end)
		end
	end

	-- HEARTBEAT: server position (desync out)
	RunService.Heartbeat:Connect(function()
		local C = cfg()
		if not C.Enabled then
			RealCFrame = nil
			RealVelocity = nil
			return
		end

		doCollect()

		local char = lplr.Character
		local myRoot = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not myRoot or not hum or hum.Health <= 0 then
			RealCFrame = nil
			return
		end

		local targetModel, targetRoot, targetHead = getClosestTarget()
		if not targetHead or not targetRoot then
			RealCFrame = nil
			return
		end

		local localFighter = FighterController.LocalFighter
		if not localFighter or not localFighter.EquippedItem then return end

		if C.JitterEnabled then updateJitter(targetRoot) end

		-- save REAL (what you see) once per tick before any move
		if not RealCFrame then
			RealCFrame = myRoot.CFrame
			RealVelocity = myRoot.AssemblyLinearVelocity
		end
		-- allow walking on the real plane
		if hum.MoveDirection.Magnitude > 0.05 then
			RealCFrame = RealCFrame + hum.MoveDirection * (hum.WalkSpeed or 16) * (1 / 60)
		end

		-- compute server CF (lock / hide) — NOT what you see
		local serverCF = RealCFrame
		if C.LockEnabled then
			local height = C.LockOffset or 12
			-- stand slightly offset so not glued to head
			local back = (targetRoot.CFrame.LookVector) * -4
			local ideal = targetRoot.Position + Vector3.new(0, height, 0) + back
			if C.JitterEnabled then ideal = ideal + currentJitterOffset end
			serverCF = CFrame.new(ideal, targetHead.Position)
		end
		if C.HideEnabled then
			local now = tick()
			if hidePhase == "hit" then
				if now - phaseStart >= (C.HitTime or 0.35) then
					hideSide = (hideSide == 1) and -1 or 1
					hidePhase = "hide"
					phaseStart = now
				end
			else
				serverCF = CFrame.new(serverCF.Position + Vector3.new(hideSide * (C.HideDistance or 100), 0, 0))
				if now - phaseStart >= (C.HideTime or 0.35) then
					hidePhase = "hit"
					phaseStart = now
				end
			end
		end

		-- desync OUT: server sees this
		myRoot.CFrame = serverCF
		myRoot.AssemblyLinearVelocity = Vector3.zero

		if tick() - lastFire >= C.FireRate then
			lastFire = tick()
			fireShots(localFighter, targetHead, serverCF.Position + Vector3.new(0, 1, 0))
		end
	end)

	-- RENDER: restore REAL before you see it (same as rage)
	pcall(function()
		RunService:UnbindFromRenderStep("ZT_RageDesyncRestore")
	end)
	RunService:BindToRenderStep("ZT_RageDesyncRestore", Enum.RenderPriority.Camera.Value - 1, function()
		local myRoot = lplr.Character and lplr.Character:FindFirstChild("HumanoidRootPart")
		if myRoot and RealCFrame then
			myRoot.CFrame = RealCFrame
			if RealVelocity then
				myRoot.AssemblyLinearVelocity = RealVelocity
			end
		end
		-- clear so next heartbeat re-snapshots cleanly
		RealCFrame = nil
		RealVelocity = nil
	end)

	print("[CuteGirl] Zombie Tower: rage desync (screen stays)")
end)




