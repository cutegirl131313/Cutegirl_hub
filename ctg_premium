local function silentGetHead()
	-- priority: locked name > FOV crosshair > nearest
	if S.LockTarget and S.TargetName and #tostring(S.TargetName) > 0 then
		local name = string.lower(tostring(S.TargetName))
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LP and validEnemy(plr) then
				local dn = string.lower(plr.DisplayName or "")
				local nn = string.lower(plr.Name or "")
				if dn:find(name, 1, true) or nn:find(name, 1, true) then
					local h = getHead(plr)
					if h then return h end
				end
			end
		end
	end
	local fov = S.AimFOV or 400
	local head = getCrosshair(fov)
	if not head then
		head = getNearest(not S.WallCheck)
	end
	if not head then return nil end
	-- force head hitbox
	if S.AlwaysHead ~= false then
		local model = head:FindFirstAncestorOfClass("Model") or head.Parent
		if model then
			local h = model:FindFirstChild("HitboxHead")
				or model:FindFirstChild("HitboxHeadSmall")
				or model:FindFirstChild("Head")
			if h then head = h end
		end
	end
	return head
end

local function silentFire(head)
	if not head or not head.Parent then return end
	refreshMods()
	if not UseItem or not EnumLibrary then return end
	local lf = getFighter()
	if not lf then return end
	if not lf.EquippedItem then
		pcall(function() lf:EquipItem(1) end)
		if not lf.EquippedItem then return end
	end
	local oid = _silent.oid
	pcall(function() oid = lf.EquippedItem:Get("ObjectID") end)
	pcall(function()
		if not oid and lf.EquippedItem.Data then oid = lf.EquippedItem.Data.ObjectID end
	end)
	if oid then _silent.oid = oid end
	if not oid then return end
	local se = _silent.se
	if not se then
		pcall(function() se = EnumLibrary:ToEnum("StartShooting") end)
		_silent.se = se
	end
	if not se then return end

	local cam = Workspace.CurrentCamera
	local root = getRootPart()
	local aimPos = head.Position
	-- optional tiny prediction
	if S.SilentPrediction then
		pcall(function()
			local hrp = head.Parent and head.Parent:FindFirstChild("HumanoidRootPart")
			if hrp then
				aimPos = head.Position + hrp.AssemblyLinearVelocity * 0.05
			end
		end)
	end

	local fromList = {}
	if cam then table.insert(fromList, cam.CFrame.Position) end
	if root then table.insert(fromList, root.Position) end
	table.insert(fromList, aimPos + Vector3.new(0, 0.05, 0))
	table.insert(fromList, aimPos + Vector3.new(0, 0.2, 0))

	for _, from in ipairs(fromList) do
		local data = encodeShot(from, aimPos, head)
		if data then
			pcall(function()
				UseItem:FireServer(oid, se, data, nil)
			end)
		end
	end
end

