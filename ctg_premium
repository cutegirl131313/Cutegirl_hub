	btn.BorderSizePixel = 1
	btn.BorderColor3 = STROKE
	btn.Font = Enum.Font.Code
	btn.TextSize = 11
	btn.Parent = row
	local function paint()
		local on = S[key] and true or false
		btn.BackgroundColor3 = on and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(20, 20, 22)
		btn.TextColor3 = on and Color3.fromRGB(10, 10, 12) or MUTED
		btn.Text = on and "ON" or "OFF"
	end
	paint()
	btn.MouseButton1Click:Connect(function()
		S[key] = not S[key]
		paint()
		if key == "RageBot" and type(runRageBot) == "function" then
			pcall(runRageBot)
		end
		if key == "Orbit" and type(setOrbit) == "function" then
			pcall(setOrbit, S.Orbit)
		end
		if key == "DeviceSpoof" then
			if S.DeviceSpoof and type(applyDeviceSpoof) == "function" then
				pcall(applyDeviceSpoof, true)
			elseif type(restoreRealDevice) == "function" then
				pcall(restoreRealDevice)
			end
		end
		if key == "UnlockAll" and S.UnlockAll and type(runLunaraUnlockAll) == "function" then
			pcall(runLunaraUnlockAll)
		end
		if key == "Freecam" then
			if S.Freecam and type(startFreecam) == "function" then pcall(startFreecam)
			elseif type(stopFreecam) == "function" then pcall(stopFreecam) end
		end
