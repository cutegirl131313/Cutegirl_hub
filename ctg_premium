local lastSilent = 0
RunService.Heartbeat:Connect(function()
	if not S.SilentAim then return end
	if tick() - lastSilent < 0.03 then return end
	local shooting = false
	pcall(function()
		shooting = UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
			or UIS:IsKeyDown(Enum.KeyCode.ButtonR2)
	end)
	if not shooting then return end
	local head = pickHead(2000)
	if not head then return end
	if S.WallCheck then
		local cam = workspace.CurrentCamera
		if cam then
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			params.FilterDescendantsInstances = { LP.Character }
			local dir = head.Position - cam.CFrame.Position
			local hit = workspace:Raycast(cam.CFrame.Position, dir, params)
			local model = head:FindFirstAncestorOfClass("Model") or head.Parent
			if hit and model and not hit.Instance:IsDescendantOf(model) then
				return
			end
		end
	end
	lastSilent = tick()
	fireAt(head, "camera")
	fireAt(head, "target")
end)

