local function CG_sameTeam(plr)
	local a, b = CG_LP:GetAttribute("TeamID"), plr:GetAttribute("TeamID")
	if a and b and a == b then return true end
	if CG_LP.Team and plr.Team and CG_LP.Team == plr.Team then return true end
	return false
end

local function CG_pickHead()
	local best, bestScore = nil, -1e9
	local cam = workspace.CurrentCamera
	if not cam then return nil end
	local root = CG_LP.Character and CG_LP.Character:FindFirstChild("HumanoidRootPart")
	local maxDist = 2000
	for _, plr in ipairs(CG_Players:GetPlayers()) do
		if plr ~= CG_LP and plr.Character then
			-- team: only skip if both have team id match; FFA ok
			local skip = false
			pcall(function()
				if CG_sameTeam and CG_sameTeam(plr) then
					-- allow if RagebotFFA
					if not getgenv().RagebotFFA then skip = true end
				end
			end)
			if not skip then
				local char = plr.Character
				local hum = char:FindFirstChildOfClass("Humanoid")
				local hrp = char:FindFirstChild("HumanoidRootPart")
				if hum and hrp and hum.Health > 0 then
					local head = char:FindFirstChild("HitboxHead")
						or char:FindFirstChild("HitboxHeadSmall")
						or char:FindFirstChild("Head")
						or hrp
					local dist = (cam.CFrame.Position - head.Position).Magnitude
					if dist < maxDist then
						local sp = cam:WorldToViewportPoint(head.Position)
						local cx, cy = cam.ViewportSize.X * 0.5, cam.ViewportSize.Y * 0.5
						local onScreen = sp.Z > 0
						local screenDist = (Vector2.new(sp.X, sp.Y) - Vector2.new(cx, cy)).Magnitude
						-- prefer crosshair-close targets
						local score = (onScreen and 5000 or 0) - screenDist - dist * 0.15
						if score > bestScore then
							bestScore = score
							best = head
						end
					end
				end
			end
		end
	end
	return best
end

