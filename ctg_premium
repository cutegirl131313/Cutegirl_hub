-- Rage + Desync + Orbit + Void
local realCF, realVel
local lastRage = 0
local orbitAngle = 0
local voidSaved

RunService.Heartbeat:Connect(function()
	local head = (S.RageBot or S.Orbit or S.VoidSpam or S.KnifeRage) and pickHead() or nil

	-- Orbit
	if S.Orbit and head then
		local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
		if hrp then
			orbitAngle = orbitAngle + 0.08
			local r = S.OrbitStuds or 8
			local o = Vector3.new(math.cos(orbitAngle) * r, 2, math.sin(orbitAngle) * r)
			hrp.CFrame = CFrame.new(head.Position + o, head.Position)
			hrp.AssemblyLinearVelocity = Vector3.zero
		end
	end

	-- Void spam (high safe TP)
	if S.VoidSpam and head then
		local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
		if hrp then
			if not voidSaved then voidSaved = hrp.CFrame end
			local rnd = Vector3.new(math.random(-40, 40), 80 + math.random(0, 40), math.random(-40, 40))
			hrp.CFrame = CFrame.new(head.Position + rnd)
			hrp.AssemblyLinearVelocity = Vector3.zero
		end
	elseif voidSaved and not S.VoidSpam then
		local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
		if hrp then pcall(function() hrp.CFrame = voidSaved end) end
		voidSaved = nil
	end

	-- Spin
	if S.SpinBot then
		local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
		if hrp then
			hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(25), 0)
		end
	end

	if not S.RageBot and not S.KnifeRage then
		realCF = nil
		return
	end
	if not head then return end
	stripProtect(head)

	local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
	if hrp and S.Desync and not S.Orbit then
		if not realCF then
			realCF = hrp.CFrame
			realVel = hrp.AssemblyLinearVelocity
		end
		local hum = LP.Character:FindFirstChildOfClass("Humanoid")
		if hum and hum.MoveDirection.Magnitude > 0.05 then
			realCF = realCF + hum.MoveDirection * (hum.WalkSpeed or 16) * (1 / 60)
		end
		local dd = S.DesyncDist or 3
		hrp.CFrame = CFrame.new(head.Position + Vector3.new(0, dd, 0), head.Position)
		hrp.AssemblyLinearVelocity = Vector3.zero
	end

	if tick() - lastRage < 0.04 then return end
	lastRage = tick()
	lastAtk = tick()

	local multi = math.clamp(S.RageMulti or 14, 2, 30)
	local hp = head.Position
	local cam = workspace.CurrentCamera
	local origins = {
		hp + Vector3.new(0, 0.1, 0),
		hp + Vector3.new(0, 0.3, 0),
		(cam and cam.CFrame.Position) or hp,
	}
	refreshMods()
	local oid = getOid()
	if oid and UseItem and SSEnum then
		for i = 1, multi do
			local from = origins[((i - 1) % #origins) + 1]
			local data = encodeShot(from, hp, head)
			if data then
				pcall(function() UseItem:FireServer(oid, SSEnum, data, nil) end)
			end
		end
	end
	fireAt(head, "target")
	fireAt(head, "camera")
end)

