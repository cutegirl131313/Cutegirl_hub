	fireAt(head, "camera")
end))

-- Void Spam (safe high TP visual restore)
local voidSaved = nil
bind(RunService.Heartbeat:Connect(function()
	if not S.VoidSpam then
		voidSaved = nil
		return
	end
	local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	if not voidSaved then voidSaved = hrp.CFrame end
	local p = Vector3.new(math.random(-20000, 20000), 6000 + math.random(0, 1500), math.random(-20000, 20000))
	hrp.CFrame = CFrame.new(p)
	hrp.AssemblyLinearVelocity = Vector3.zero
	pcall(function()
		RunService:BindToRenderStep("CG_void", Enum.RenderPriority.Camera.Value - 1, function()
			if hrp and voidSaved then hrp.CFrame = voidSaved end
			pcall(function() RunService:UnbindFromRenderStep("CG_void") end)
		end)
	end)
end))

-- Auto Loadout slot
bind(RunService.Heartbeat:Connect(function()
	if not S.AutoLoadout then return end
	refreshMods()
	local lf = Fighter and Fighter.LocalFighter
	if lf then
		pcall(function() lf:EquipItem(S.LoadoutSlot or 1) end)
	end
end))

-- Hit sound simple
local function playHitTone()
	if not S.HitSound then return end
	pcall(function()
		local s = Instance.new("Sound")
		s.SoundId = "rbxassetid://6042053626"
		s.Volume = 1.5
		s.Parent = workspace.CurrentCamera or workspace
		s:Play()
		task.delay(1, function() s:Destroy() end)
	end)
end
-- wrap hitFeedback
local _hf = hitFeedback
hitFeedback = function(name, dmg)
	playHitTone()
	return _hf(name, dmg)
end

-- ===================== UI (Linoria) =====================
local Library, ThemeManager, SaveManager
local function loadLib()
	local repos = {
		"https://raw.githubusercontent.com/mstudio45/LinoriaLib/main/",
		"https://raw.githubusercontent.com/violin-suzutsuki/LinoriaLib/main/",
	}
	for _, repo in ipairs(repos) do
		local ok, lib = pcall(function()
			return loadstring(game:HttpGet(repo .. "Library.lua"))()
		end)
		if ok and lib then
			Library = lib
			pcall(function() ThemeManager = loadstring(game:HttpGet(repo .. "addons/ThemeManager.lua"))() end)
			pcall(function() SaveManager = loadstring(game:HttpGet(repo .. "addons/SaveManager.lua"))() end)
			return true
		end
	end
	return false
end

if not loadLib() then
	warn("[CuteGirl] UI library failed")
	return
end

