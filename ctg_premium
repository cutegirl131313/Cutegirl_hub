-- Jump Power (velocity) + Double Jump + Infinite Jump
task.spawn(function()
	local UIS = game:GetService("UserInputService")
	local RunService = game:GetService("RunService")
	local Players = game:GetService("Players")
	local LP = Players.LocalPlayer
	local jumpsLeft = 0
	local lastJump = 0

	local function getHum()
		return LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
	end
	local function getRoot()
		return LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
	end

	local function doBoostJump()
		local h = _G.HUB or S
		local root = getRoot()
		local hum = getHum()
		if not root or not hum then return end
		local jp = tonumber(h.JumpPowerValue) or 50
		-- stronger vertical impulse so game can't ignore JumpPower property
		local vy = math.clamp(jp * 1.15, 40, 180)
		local v = root.AssemblyLinearVelocity
		root.AssemblyLinearVelocity = Vector3.new(v.X, vy, v.Z)
		pcall(function()
			hum:ChangeState(Enum.HumanoidStateType.Jumping)
		end)
	end

	local function onJumpRequest()
		local h = _G.HUB or S
		if not h then return end
		local now = tick()
		if now - lastJump < 0.12 then return end

		local hum = getHum()
		if not hum or hum.Health <= 0 then return end
		local state = hum:GetState()
		local onGround = state == Enum.HumanoidStateType.Running
			or state == Enum.HumanoidStateType.RunningNoPhysics
			or state == Enum.HumanoidStateType.Landed
			or state == Enum.HumanoidStateType.Climbing
			or hum.FloorMaterial ~= Enum.Material.Air

		if h.InfJump then
			lastJump = now
			doBoostJump()
			return
		end

		if onGround then
			jumpsLeft = (h.DoubleJump and 1) or 0
			if h.JumpPower then
				lastJump = now
				doBoostJump()
			end
			return
		end

		-- mid-air
		if h.DoubleJump and jumpsLeft > 0 then
			jumpsLeft = jumpsLeft - 1
			lastJump = now
			doBoostJump()
		elseif h.JumpPower and onGround then
			lastJump = now
			doBoostJump()
		end
	end

	pcall(function()
		UIS.JumpRequest:Connect(function()
			onJumpRequest()
		end)
	end)

	-- mobile / hold space spam for inf jump
	RunService.Heartbeat:Connect(function()
		local h = _G.HUB or S
		if not h or not h.InfJump then return end
		if tick() - lastJump < 0.18 then return end
		local held = false
		pcall(function()
			held = UIS:IsKeyDown(Enum.KeyCode.Space) or UIS:IsKeyDown(Enum.KeyCode.ButtonA)
		end)
		if held then
			lastJump = tick()
			doBoostJump()
		end
	end)

	-- keep humanoid jump stats applied when JumpPower on
	RunService.Heartbeat:Connect(function()
		local h = _G.HUB or S
		if not h or not h.JumpPower then return end
		local hum = getHum()
		if not hum then return end
		local jp = tonumber(h.JumpPowerValue) or 50
		pcall(function()
			hum.UseJumpPower = true
			hum.JumpPower = jp
			hum.JumpHeight = math.clamp(jp / 7.2, 2, 60)
		end)
	end)

	LP.CharacterAdded:Connect(function()
		jumpsLeft = 0
	end)
end)


