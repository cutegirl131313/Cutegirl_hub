local function applyHubAnti()
	-- 1) Kick / Ban namecall block
	pcall(function()
		local mt = getrawmetatable(game)
		if not mt then return end
		setreadonly(mt, false)
		local old = mt.__namecall
		mt.__namecall = newcclosure(function(self, ...)
			local method = getnamecallmethod()
			if method == "Kick" or method == "Ban" or method == "kick" then
				return
			end
			if type(method) == "string" then
				local ml = string.lower(method)
				if string.find(ml, "kick") or method == "Shutdown" then
					return
				end
			end
			return old(self, ...)
		end)
		setreadonly(mt, true)
	end)

	-- 2) ClientAlert spoof (hub anti)
	pcall(function()
		local fake = Instance.new("RemoteEvent")
		fake.Name = "ClientAlert"
		fake.Parent = LocalPlayer

		local pmt = getrawmetatable(LocalPlayer)
		if pmt then
			local oldnc = pmt.__namecall
			setreadonly(pmt, false)
			pmt.__namecall = newcclosure(function(self, ...)
				if getnamecallmethod() == "WaitForChild" and select(1, ...) == "ClientAlert" then
					return fake
				end
				return oldnc(self, ...)
			end)
			setreadonly(pmt, true)
		end
	end)

	-- 3) Hide kick prompt
	pcall(function()
		local CoreGui = game:GetService("CoreGui")
		local function hidePrompt(v)
			if v.Name == "RobloxPromptGui" then
				local prompt = v:FindFirstChild("promptOverlay", true)
				if prompt then prompt.Visible = false end
			end
		end
		for _, v in pairs(CoreGui:GetChildren()) do
			hidePrompt(v)
		end
		CoreGui.ChildAdded:Connect(hidePrompt)
	end)

	-- 4) Disable obvious AC local scripts by name
	task.spawn(function()
		pcall(function()
			local tags = {"anticheat", "ac", "detection", "ban", "kick", "security", "moderation"}
			local function proc(o)
				pcall(function()
					if o:IsA("LocalScript") or o:IsA("ModuleScript") then
						local nm = string.lower(o.Name)
						for i = 1, #tags do
							if string.find(nm, tags[i], 1, true) then
								pcall(function() o.Disabled = true end)
								break
							end
						end
					end
				end)
			end
			for _, o in ipairs(game:GetDescendants()) do
				proc(o)
			end
			game.DescendantAdded:Connect(proc)
		end)
	end)

	print("[CuteGirl] hub anti applied")
end

-- apply after short delay so UI is already up
task.defer(function()
	task.wait(0.5)
	pcall(applyHubAnti)
end)

